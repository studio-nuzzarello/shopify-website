<!doctype html>
<html
  class="no-js"
  lang="{{ request.locale.iso_code }}"
  data-scheme="{{ settings.color_scheme }}"
  dir="{% render 'direction' %}"
>
  <head>    
    <script id="Cookiebot" src="https://consent.cookiebot.com/uc.js" data-cbid="962b7ec4-9a54-49c0-b795-9bd30890b329"  type="text/javascript"></script>
