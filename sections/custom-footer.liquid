<script type="application/ld+json">
  {%- assign list = '' -%}
  {%- assign pos = 1 -%}

  {%- capture home_item -%}
  {
    "@type": "ListItem",
    "position": {{ pos }},
    "name": "Home",
    "item": {{ request.origin | append: '/' | json }}
  }
  {%- endcapture -%}
  {%- assign list = list | append: home_item -%}
  {%- assign pos = pos | plus: 1 -%}

  {%- unless template.name == 'index' -%}

    {%- if template.name == 'product' -%}

      {%- if product.metafields.custom.main_category -%}
        {%- capture cat_item -%},
  {
    "@type": "ListItem",
    "position": {{ pos }},
    "name": {{ product.metafields.custom.main_category.value.title | json }},
    "item": {{ product.metafields.custom.main_category.value.url | prepend: request.origin | json }}
  }
        {%- endcapture -%}
        {%- assign list = list | append: cat_item -%}
        {%- assign pos = pos | plus: 1 -%}
      {%- endif -%}

      {%- capture current_item -%},
  {
    "@type": "ListItem",
    "position": {{ pos }},
    "name": {{ product.title | json }},
    "item": {{ product.url | prepend: request.origin | json }}
  }
      {%- endcapture -%}
      {%- assign list = list | append: current_item -%}

    {%- elsif template.name == 'collection' -%}

      {%- if current_tags and current_tags.size > 0 -%}
        {%- capture base_collection_item -%},
  {
    "@type": "ListItem",
    "position": {{ pos }},
    "name": {{ collection.title | json }},
    "item": {{ collection.url | prepend: request.origin | json }}
  }
        {%- endcapture -%}
        {%- assign list = list | append: base_collection_item -%}
        {%- assign pos = pos | plus: 1 -%}

        {%- assign tag_label = current_tags | join: ", " -%}

        {%- if current_tags.size == 1 -%}
          {%- assign tag_handle = current_tags.first | handleize -%}
          {%- assign tag_metadata = metaobjects.tag_metadata[tag_handle] -%}
          {%- if tag_metadata != blank and tag_metadata.meta_title.value != blank -%}
            {%- assign tag_label = tag_metadata.meta_title.value -%}
          {%- endif -%}
        {%- endif -%}

        {%- assign tag_url = request.origin | append: request.path -%}

        {%- capture tag_item -%},
  {
    "@type": "ListItem",
    "position": {{ pos }},
    "name": {{ tag_label | json }},
    "item": {{ tag_url | json }}
  }
        {%- endcapture -%}
        {%- assign list = list | append: tag_item -%}

      {%- else -%}
        {%- capture current_item -%},
  {
    "@type": "ListItem",
    "position": {{ pos }},
    "name": {{ collection.title | json }},
    "item": {{ collection.url | prepend: request.origin | json }}
  }
        {%- endcapture -%}
        {%- assign list = list | append: current_item -%}
      {%- endif -%}

    {%- elsif template.name == 'article' or request.page_type == 'article' -%}

      {%- comment -%} Blog-Übersicht als eigener Crumb {%- endcomment -%}
      {%- capture blog_item -%},
  {
    "@type": "ListItem",
    "position": {{ pos }},
    "name": {{ blog.title | json }},
    "item": {{ blog.url | prepend: request.origin | json }}
  }
      {%- endcapture -%}
      {%- assign list = list | append: blog_item -%}
      {%- assign pos = pos | plus: 1 -%}

      {%- comment -%} Artikel {%- endcomment -%}
      {%- capture article_item -%},
  {
    "@type": "ListItem",
    "position": {{ pos }},
    "name": {{ article.title | json }},
    "item": {{ article.url | prepend: request.origin | json }}
  }
      {%- endcapture -%}
      {%- assign list = list | append: article_item -%}

    {%- else -%}

      {%- assign other_name = page_title -%}
      {%- if request.page_type == 'policy' and policy -%}
        {%- assign other_name = policy.title -%}
      {%- elsif request.page_type == 'cart' -%}
        {%- assign other_name = "Warenkorb" -%}
      {%- elsif request.page_type == 'search' -%}
        {%- assign other_name = "Suche" -%}
      {%- elsif blog -%}
        {%- assign other_name = blog.title -%}
      {%- elsif page -%}
        {%- assign other_name = page.title -%}
      {%- endif -%}

      {%- capture other_item -%},
  {
    "@type": "ListItem",
    "position": {{ pos }},
    "name": {{ other_name | json }},
    "item": {{ request.origin | append: request.path | json }}
  }
      {%- endcapture -%}
      {%- assign list = list | append: other_item -%}

    {%- endif -%}

  {%- endunless -%}

  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {{ list }}
    ]
  }
</script>

{% schema %}
{
  "name": "Custom Footer",
  "tag": "section",
  "class": "custom-footer-section",
  "settings": [],
  "presets": [
    {
      "name": "Custom Footer"
    }
  ]
}
{% endschema %}
