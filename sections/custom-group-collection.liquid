{% style %}
  .category__filter--reset {
    margin-inline-start: 18px;
    color: rgb(0, 102, 204);
    font-size: 13px;
    cursor: pointer;
  }
  .category__group.is-hidden {
    display: none;
  }
  .category__filter {
    background-color: #f5f5f7;
    border: 5px solid #fff;
    border-radius: 20px;
    max-width: 980px;
    margin: 0 auto;
    padding-left: 4rem;
    padding-right: 4rem;
    padding-top: 1.3rem;
    padding-bottom: 1.3rem;
    margin-bottom: 0;
    display: flex;
    flex-wrap: wrap;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.016em;
    line-height: 1.4285914286;
  }
  @media (max-width: 989px) {
    .category__filter {
      padding-left: 2rem;
      padding-right: 2rem;
      margin-left: 2rem;
      margin-right: 2rem;
    }
  }
  .category__filter--option input[type='checkbox'] {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .category__filter--option > span {
    display: inline-flex;
    align-items: center;
    border-radius: 8px;
    font-weight: 400;
    margin: 2px 0;
    opacity: 0.8;
    padding: 5px 7px;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
    cursor: pointer;
  }

  /* Hover */
  .category__filter--option:hover > span {
    background: #f5f5f7;
  }

  .category__filter--option input:checked + span {
    background-color: #dbdcf2;
    color: #2925af;
    border-color: rgb(207, 208, 229);
  }

  .category__filter--option input:focus-visible + span {
    outline: 2px solid #1d1d1f;
    outline-offset: 2px;
  }
  .category__filter--dimension summary::-webkit-details-marker {
    display: none;
  }

  .category__filter--button svg {
    transition: transform 0.2s ease;
  }

  .category__filter--dimension[open] .category__filter--button svg {
    transform: rotate(180deg);
  }
  .category__filter--summary {
    display: flex;
  }

  .category__filter--button {
    display: flex;
    cursor: pointer;
    width: 163px;
  }
  .category__filter--button svg {
    margin-right: 3px;
    margin-top: 4px;
  }
  .category__faq {
    max-width: 1140px;
    margin: 50px auto 0;
    padding-left: 8rem;
    padding-right: 8rem;
    text-align: start;
    padding-top: 5.2rem;
    padding-bottom: 5.2rem;
  }
  @media (max-width: 989px) {
    .category__faq {
      padding-left: 2rem;
      padding-right: 2rem;
    }
  }
  .category__faq--title {
    font-size: 21px;
    font-weight: 600;
    letter-spacing: 0.011em;
    line-height: 1.1428571429;
    text-align: center;
    padding-bottom: 2.6rem;
  }
  @media (max-width: 989px) {
    .category__faq--title {
      text-align: start;
    }
  }
  .category__faq--question {
    display: flex;
    justify-content: space-between;
    cursor: pointer;
  }
  .category__faq--svg {
    transition: transform 0.2s ease;
    transform-origin: center;
    flex-shrink: 0;
    margin-left: 10px;
  }
  .category__faq--item[open] .category__faq--question .category__faq--svg {
    transform: rotate(180deg);
  }
  .category__faq--answer {
    padding-top: 30px;
    font-size: 14px;
    font-weight: 400;
    letter-spacing: -0.016em;
    line-height: 1.4285914286;
  }
  .category__faq--item {
    border-top: 1px solid #d2d2d7;
    padding-top: 17px;
    padding-bottom: 17px;
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.022em;
    line-height: 1.2353641176;
  }
  .category__faq--item:last-child {
    border-bottom: 1px solid #d2d2d7;
  }
  .category__title {
    max-width: 1140px;
    margin: 50px auto;
    padding-left: 8rem;
    padding-right: 8rem;
    font-size: 21px;
    font-weight: 600;
    letter-spacing: 0.011em;
    line-height: 1.1428571429;
    text-align: center;
  }
  @media (max-width: 989px) {
    .category__title {
      padding-left: 2rem;
      padding-right: 2rem;
      text-align: start;
      padding-top: 30px;
    }
  }
  .category__group {
    max-width: 1140px;
    margin: 50px auto;
    margin-top: 0;
    padding-left: 8rem;
    padding-right: 8rem;
    display: flex;
    flex-wrap: wrap;
    overflow-x: hidden;
  }
  @media (max-width: 989px) {
    .category__group {
      padding-left: 2rem;
      padding-right: 2rem;
    }
  }
  .pinwheel {
    background-color: #f5f5f7;
    border: 5px solid #fff;
    border-radius: 20px;
    list-style-type: none;
    overflow: hidden;
    height: 673px;
  }
  .pinwheel.hidden {
    display: none;
  }
  .pinwheel__tile {
    box-sizing: border-box;
    max-width: 100%;
    padding: 40px 40px 34px;
    text-align: center;
  }
  @media (max-width: 989px) {
    .pinwheel__tile {
      padding: 40px 20px 34px;
    }
  }
  .flex-4 {
    flex-basis: 33.3333333333%;
    max-width: 33.3333333333%;
  }
  .flex-6 {
    flex-basis: 50%;
    max-width: 50%;
  }
  .flex-8 {
    flex-basis: 66.6666666667%;
    max-width: 66.6666666667%;
  }

  @media (max-width: 989px) {
    .category__group {
      flex-direction: column;
    }

    /* alle Kacheln volle Breite */
    .category__group > .pinwheel {
      flex-basis: 100%;
      max-width: 100%;
      order: 2; /* default: unter dem großen */
      height: auto; /* optional, sonst bleiben 673px hoch */
    }
  }

  .pinwheel__headline {
    font-size: 21px;
    font-weight: 600;
    letter-spacing: 0.011em;
    line-height: 1.1428571429;
    text-align: start;
    padding-bottom: 3.5rem;
  }
  .pinwheel__description {
    text-align: start;
    font-size: 14px;
    line-height: 1.2857742857;
    font-weight: 400;
    letter-spacing: -0.016em;
  }
  .pinwheel__bullets .metafield-rich_text_field ul li {
    text-align: start;
    list-style-position: outside;
    margin-left: 2rem;
    font-size: 14px;
    line-height: 1.2857742857;
    font-weight: 400;
    letter-spacing: -0.016em;
  }

  .pinwheel__image--wrapper {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    margin-top: 26px;
    margin-bottom: 31px;
    max-height: 395px;
  }
  .pinwheel__image {
    max-width: 100%;
    height: auto;
    object-fit: contain;
    max-height: 395px;
  }
  .pinwheel__title {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.016em;
    line-height: 1.428591;
    padding: 15px 15px 30px;
    min-height: 54px;
  }
  .pinwheel__price--current {
    font-size: 14px;
    font-weight: 400;
    letter-spacing: -0.016em;
    line-height: 1.428591;
  }
{% endstyle %}

<script src="{{ 'custom-group-collection.js' | asset_url }}" defer></script>

{%- assign quicknav_title = collection.title -%}
{%- assign quicknav_intro = collection.description | strip_html -%}

{%- if request.page_type == 'collection' and current_tags and current_tags.size > 0 -%}
  {%- for tag in current_tags -%}
    {%- assign tag_handle = tag | handleize -%}
    {%- assign tag_metadata = metaobjects.tag_metadata[tag_handle] -%}

    {%- if tag_metadata != blank -%}
      {%- if tag_metadata.title.value != blank -%}
        {%- assign quicknav_title = tag_metadata.title.value -%}
      {%- endif -%}

      {%- if tag_metadata.description.value != blank -%}
        {%- assign quicknav_intro = tag_metadata.description.value -%}
      {%- endif -%}

      {%- if tag_metadata.title.value != blank or tag_metadata.description.value != blank -%}
        {%- break -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

<div class="quicknav__container" style="background-color: #fff;">
  <div class="quicknav mobile-block">
    <h1 class="quicknav__category">{{ quicknav_title | escape }}</h1>
    <p class="quicknav__intro">{{ quicknav_intro | strip_html | strip }}</p>
  </div>
  <div class="quicknav__border"></div>
</div>

{% assign slides = collection.metafields.custom.slides.value %}
{% assign preferred_types = "Gewichte & Sicherung|Beleuchtung & Heizung|Tische & Zeltboden|Taschen & Transport" | split: "|" %}


<h2 class="category__title">
  <span class="michroma-regular">STORM</span> –
  <span style="color:#6e6e73;">die Profi-Serie: extra stabil bei Wind & Wetter</span>
</h2>

{% if current_tags == blank %}
  <div class="category__filter">
    <details class="category__filter--dimension">
      <summary class="category__filter--summary">
        <div class="category__filter--button">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M6 9l6 6l6 -6" />
          </svg>
          Filter
          <button class="category__filter--reset hidden">Reset</button>
        </div>
        <div class="category__filter--dimension-label">Typ <span class="category__filter--count" hidden>(0)</span></div>
      </summary>
      <div style="display: flex; padding-top: 5px;">
        <div style="width: 163px;"></div>
        <div class="category__filter--options">
          <fieldset>
            <legend class="visually-hidden">Zubehör filtern</legend>
            {% for type in preferred_types %}
              <label class="category__filter--option">
                <input type="checkbox" name="type" value="{{ type | handleize }}">
                <span>
                  {{- type -}}
                </span>
              </label>
            {% endfor %}
          </fieldset>
        </div>
      </div>
    </details>
  </div>
{% endif %}

{% for type in preferred_types %}
  <div class="category__group" data-type="{{ type | handleize }}">
    {% if current_tags == blank %}
      {% for slide in slides %}
        {% if slide.label == type %}
          <div class="pinwheel flex-4">
            <div class="pinwheel__tile">
              {% if slide %}
                {% if slide.headline.value %}
                  <h3 class="pinwheel__headline">
                    {{ slide.headline.value }}
                  </h3>
                {% endif %}

                {% if slide.image %}
                  <div class="pinwheel__image--wrapper">
                    {% if forloop.first %}
                      <div class="pinwheel__image">
                        {{
                          slide.image
                          | image_url: width: 474
                          | image_tag: class: 'pinwheel__image', loading: 'eager', fetchpriority: 'high', alt: slide.alt
                        }}
                      </div>
                    {% else %}
                      <div class="pinwheel__image">
                        {{
                          slide.image
                          | image_url: width: 474
                          | image_tag: class: 'pinwheel__image', loading: 'lazy', fetchpriority: 'low', alt: slide.alt
                        }}
                      </div>
                    {% endif %}
                  </div>
                {% endif %}

                {% if slide.description %}
                  <div class="pinwheel__description">
                    {{ slide.description | metafield_tag }}
                  </div>
                {% endif %}

                {% if slide.bullet_points %}
                  <div class="pinwheel__bullets">
                    {{ slide.bullet_points | metafield_tag }}
                  </div>
                {% endif %}
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    {% endif %}
    {% assign collection_group = collection.products | where: 'type', type %}
    {% for product in collection_group %}
      {% if product.type == type %}
        <div
          class="pinwheel {% if current_tags == blank %}{% if forloop.first %}flex-8{% else %}flex-6{% endif %}{% else %}flex-6{% endif %}"
        >
          <div class="pinwheel__tile">
            <a
              href="{{ product.url }}"
              aria-label="{{ product.title }}"
            >
              {% if product.featured_image %}
                <div class="pinwheel__image--wrapper">
                  <div class="pinwheel__image">
                    {{
                      product.featured_image
                      | image_url: width: 1110
                      | image_tag: class: 'pinwheel__image', loading: 'lazy', fetchpriority: 'low'
                    }}
                  </div>
                </div>
              {% endif %}
              <h4 class="pinwheel__title">
                {{ product.title }}
              </h4>

              <div class="pinwheel__price">
                <span class="pinwheel__price--current">
                  {% if product.price_varies %}
                    {{ product.price_min | money }} - {{ product.price_max | money }}
                  {% else %}
                    {{ product.price | money }}
                  {% endif %}
                </span>
              </div>
            </a>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
{% endfor %}

{% if collection.metafields.custom.faq %}
  {% assign faqs = collection.metafields.custom.faq.value %}

  <section class="category__faq">
    <h2 class="category__faq--title">FAQ</h2>

    {% for faq in faqs %}
      <details class="category__faq--item">
        <summary class="category__faq--question">
          {{ faq.question }}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="#6e6e73"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="category__faq--svg"
          >
            <path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M6 9l6 6l6 -6" />
          </svg>
        </summary>
        <div class="category__faq--answer">
          {{ faq.answer }}
        </div>
      </details>
    {% endfor %}
  </section>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {% for faq in faqs %}
          {
            "@type": "Question",
            "name": {{ faq.question | strip | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ faq.answer | strip_html | strip | json }}
            }
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]
    }
  </script>
{% endif %}

{% comment %}
{% javascript %}
  document.addEventListener('DOMContentLoaded', () => {
    const checkboxes = Array.from(
      document.querySelectorAll('.category__filter--option input[type="checkbox"][name="type"]')
    );
    const categories = Array.from(document.querySelectorAll('.category__group[data-type]'));
    const countEl = document.querySelector('.category__filter--count');
    const resetBtn = document.querySelector('.category__filter--reset');

    if (!checkboxes.length || !categories.length) return;

    const applyFilter = () => {
      const checked = checkboxes.filter((cb) => cb.checked);
      const selectedValues = new Set(checked.map((cb) => cb.value));

      // Wenn nichts ausgewählt: alles anzeigen
      const showAll = selectedValues.size === 0;

      categories.forEach((cat) => {
        const type = cat.getAttribute('data-type');
        const shouldShow = showAll || selectedValues.has(type);
        cat.classList.toggle('is-hidden', !shouldShow);
      });

      // Counter (Typ (n))
      if (countEl) {
        if (checked.length > 0) {
          countEl.textContent = `(${checked.length})`;
          countEl.hidden = false;
        } else {
          countEl.hidden = true;
        }
      }

      // Reset Button nur zeigen, wenn mind. 1 Filter aktiv ist
      if (resetBtn) {
        resetBtn.classList.toggle('hidden', checked.length === 0);
      }
    };

    // Reset: alle Checkboxen aus + Filter neu anwenden
    if (resetBtn) {
      resetBtn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation(); // verhindert details-toggle durch summary

        checkboxes.forEach((cb) => {
          cb.checked = false;
        });
        applyFilter();
      });
    }

    // initial
    applyFilter();

    // Änderungen
    checkboxes.forEach((cb) => cb.addEventListener('change', applyFilter));
  });
{% endjavascript %}

{% endcomment %}

