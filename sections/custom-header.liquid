{% comment %}

{% style %}
  /* only show on mobile */
  @media (min-width: 834px) {
    .custom-header-section .mobile-menu {
      display: none;
    }
  }
  html:has(.mobile-menu[open]),
  body:has(.mobile-menu[open]) {
    overflow: hidden;
  }

  @media (max-width: 833px) {
    .custom-header-section .mobile-menu {
      position: relative;
    }

    /* remove default marker */
    .custom-header-section .mobile-menu > summary {
      list-style: none;
    }
    .custom-header-section .mobile-menu > summary::-webkit-details-marker {
      display: none;
    }

    /* clickable toggle area */
    .custom-header-section .mobile-menu__toggle {
      cursor: pointer;
      display: block;
      width: 24px;
      height: 24px;
      position: relative;
    }

    /* icon switching */
    .custom-header-section .mobile-menu__toggle .close-menu-icon {
      display: none;
    }
    .custom-header-section .mobile-menu[open] .mobile-menu__toggle .open-menu-icon {
      display: none;
    }
    .custom-header-section .mobile-menu[open] .mobile-menu__toggle .close-menu-icon {
      display: block;
    }

    /* backdrop */
    .custom-header-section .mobile-menu__backdrop {
      display: none;
    }
    .custom-header-section .mobile-menu[open] .mobile-menu__backdrop {
      display: block;
      position: fixed;
      left: 0;
      right: 0;
      top: calc(3.4rem + 44px);
      bottom: 0;
      background-color: #01292c;
      z-index: 1999;
    }

    /* the panel itself: fixed overlay; scroll INSIDE panel */
    .custom-header-section .mobile-menu__panel {
      display: none;
    }

    .custom-header-section .mobile-menu[open] .mobile-menu__panel {
      display: block;
      position: fixed;
      left: 0;
      right: 0;
      top: calc(3.4rem + 44px);
      bottom: 0;

      z-index: 2000;

      overflow-y: auto;
      -webkit-overflow-scrolling: touch;

      /* optional: prevent page “bounce” feel */
      overscroll-behavior: contain;
    }
  }

  .global__header {
    background-color: #01292c;
  }

  .announcement-bar__wrapper {
    display: flex;
    font-size: 13px;
    font-weight: 600;
    margin-right: auto;
    margin-left: auto;
    padding-left: 2rem;
    padding-right: 2rem;
    background-color: inherit;
    color: #fff;
    min-height: 3.4rem;
    max-height: 3.4rem;
    align-items: center;
    justify-content: center;
  }

  @media screen and (min-width: 990px) {
    .announcement-bar__wrapper {
      margin: 0 auto;
      max-width: 1140px;
      padding-left: 8rem;
      padding-right: 8rem;
    }
  }

  @media screen and (min-width: 834px) {
    .announcement-bar__wrapper {
      justify-content: space-between;
    }
  }

  .announcement-bar__section[data-section='hide'] {
    display: flex;
    gap: 13px;
  }

  .announcement-bar__section-element {
    display: flex;
    transition: all 0.3s cubic-bezier(0, 0, 0.5, 1);
  }

  .announcement-bar__section-element[data-element='first']:hover,
  .announcement-bar__section-element[data-element='second']:hover,
  .announcement-bar__section-element[data-element='third']:hover {
    -webkit-transform: scale(1.01);
    transform: scale(1.01);
  }

  @media screen and (max-width: 833px) {
    .announcement-bar__section[data-section='hide'] {
      display: none !important;
    }
  }

  .announcement-bar__mail {
    color: #fff;
    text-decoration: underline;
    display: inline-flex;
    align-items: center;
    padding-top: 0.325rem;
    transition: all 0.3s cubic-bezier(0, 0, 0.5, 1);
  }

  .announcement-bar__mail:hover {
    -webkit-transform: scale(1.01);
    transform: scale(1.01);
  }

  .announcement-bar__call {
    color: #fff;
    text-decoration: underline;
    transition: all 0.3s cubic-bezier(0, 0, 0.5, 1);
  }

  .announcement-bar__call:hover {
    -webkit-transform: scale(1.01);
    transform: scale(1.01);
  }

  .announcement-bar__section-svg {
    margin-right: 3px;
    min-width: 14px;
    min-height: 14px;
    position: relative;
    top: 3px;
  }

  .global__nav {
    position: relative;
    z-index: 100;
    background-color: inherit;
    color: #fff;
    display: flex;
    justify-content: space-between;
    max-width: 1140px;
    padding-left: 2rem;
    padding-right: 2rem;
    margin: 0px auto;
    height: calc(44px * 1);
    align-items: center;
  }

  @media screen and (min-width: 990px) {
    .global__nav {
      padding-left: 8rem;
      padding-right: 8rem;
    }
  }

  .global__nav-submenu {
    background-color: #ff5700;
    color: #fff;
    display: flex;
    justify-content: center;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    width: 100%;
    padding-top: 40px;
    padding-bottom: 84px;
    z-index: 1000;
  }

  /* Mobile submenu container (still needs JS or DOM move for pure CSS toggle) */
  .global__nav-submenu-mobile {
    background-color: inherit;
    color: #fff;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    width: 100%;
    min-height: 100vh;
    min-height: 100dvh;
    z-index: 1000;
  }

  .global__nav-submenu-content {
    max-width: 1180px;
    width: 100%;
    display: flex;
    padding-left: 2rem;
    padding-right: 2rem;
    box-sizing: border-box;
    gap: 88px;
  }

  @media screen and (min-width: 990px) {
    .global__nav-submenu-content {
      padding-left: 10rem;
      padding-right: 10rem;
    }
  }

  .global__nav-submenu-group {
    padding-right: 88px;
  }

  .global__nav-submenu-header {
    font-size: 12px;
    line-height: 1.3333733333;
    font-weight: 400;
    letter-spacing: -0.01em;
    color: rgba(255, 255, 255, 0.8);
    padding: 7px 11px;
    margin-bottom: -6px;
  }

  .global__nav-submenu-link a {
    margin-top: 9px;
    color: #fff;
    font-size: 24px;
    line-height: 1.1666666667;
    font-weight: 600;
    letter-spacing: 0.009em;
    padding: 7px 11px;
    margin-bottom: -6px;
  }

  .hidden {
    display: none;
  }

  .global__nav-submenu-quicklink a {
    margin-top: 7px;
    color: #fff;
    padding: 7px 11px;
    margin-bottom: -6px;
    font-size: 12px;
    line-height: 1.3333733333;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .global__nav-icon {
    height: 22px;
    width: 22px;
  }

  .cart-icon-bubble-svg {
    height: 28px;
    width: 28px;
    top: auto;
    left: auto;
  }

  .header__icon {
    font-size: 13px;
  }

  .global__nav-list {
    align-items: center;
    display: flex;
    justify-content: space-between;
    cursor: default;
    margin: 0;
    width: auto;
    gap: 33px;
    font-size: 13px;
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1;
  }

  .global__nav-link {
    color: #fff;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0, 0, 0.5, 1);
  }

  .global__nav-desktop-links {
    display: none;
  }

  @media screen and (min-width: 834px) {
    .global__nav-desktop-links {
      display: block;
    }
  }

  .global__nav-mobile-links {
    display: block;
    cursor: pointer;
    position: relative;
  }

  @media screen and (min-width: 834px) {
    .global__nav-mobile-links {
      display: none;
    }
  }

  /* Hide the checkbox */
  .global__nav-mobile-links input[type='checkbox'] {
    display: none;
  }

  /* Hide all icons by default */
  .global__nav-mobile-links svg {
    display: none;
    width: 24px;
    height: 24px;
  }

  /* Show hamburger by default */
  .global__nav-mobile-links .open-menu-icon {
    display: block;
  }

  /* Toggle icons when checkbox is checked */
  .global__nav-mobile-links input[type='checkbox']:checked + .open-menu-icon {
    display: none;
  }

  .global__nav-mobile-links input[type='checkbox']:checked ~ .close-menu-icon {
    display: block;
  }

  /* Full-size label to capture clicks */
  .global__nav-mobile-links label {
    position: absolute;
    top: 0;
    left: 0;
    width: 24px;
    height: 24px;
    cursor: pointer;
    display: block;
    z-index: 2;
  }
  @media (min-width: 834px) {
    .custom-header-section .global__nav-submenu {
      position: fixed;
      top: calc(3.4rem + 44px);
      left: 0;
      right: 0;
      width: 100vw;
    }
  }
  @media (min-width: 834px) {
    .global__nav-submenu-blur {
      position: absolute;
      top: 100%;
      left: 0;
      width: 100%;
      height: 100vh;
      background: rgba(232, 232, 237, 0.1);
      backdrop-filter: blur(20px);
      pointer-events: none;
      z-index: 1001;
    }
  }
{% endstyle %}
{% endcomment %}

