<div class="home-section">
  <div class="home__unit home__unit--hero">
    <div class="home__unit--copy">
        <h1 class="home__title">
          <span class="michroma-regular">{{ metaobjects.landing_page.main.title.value }}</span>
        </h1>
        <p class="home__title--intro">{{ metaobjects.landing_page.main.description.value }}</p>
      <div class="cta-links">
        <a
          href="{{ routes.collections_url }}/{{ metaobjects.landing_page.main.collection.value.handle }}"
          aria-label="{{ metaobjects.landing_page.main.button_a }}"
          class="button button--primary content-card__button"
        >
          <div class="button__content">
            <span class="button__label" data-label="{{ metaobjects.landing_page.main.button_a }}">
              {{- metaobjects.landing_page.main.button_a -}}
            </span>
            <div class="button__icons">
              <span class="button__icon">
                <svg
                  aria-hidden="true"
                  width="12"
                  height="12"
                  viewBox="0 0 12 12"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path d="M1.5 10.5011L10.2421 1.75789M2.46394 1.05078H10.9492V9.53606" stroke="currentColor" stroke-width="1.4" stroke-linecap="square"></path>
                </svg>
              </span>
              <span class="button__icon button__icon--2">
                <svg
                  aria-hidden="true"
                  width="12"
                  height="12"
                  viewBox="0 0 12 12"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path d="M1.5 10.5011L10.2421 1.75789M2.46394 1.05078H10.9492V9.53606" stroke="currentColor" stroke-width="1.4" stroke-linecap="square"></path>
                </svg>
              </span>
            </div>
          </div>
          <span class="animated-button-circle" style="transform-origin: 13.119795% 126.875%;"></span>
        </a>
        <a
          href="/products/{{ metaobjects.landing_page.main.product.value.handle }}"
          aria-label="{{ metaobjects.landing_page.main.button_b }}"
          class="button button--primary content-card__button"
          style="background-color: #f5f5f7; border: 1px solid rgb(255, 64, 20);"
        >
          <div class="button__content">
            <span
              class="button__label"
              data-label="{{ metaobjects.landing_page.main.button_b }}"
              style="color: rgb(255, 64, 20);"
            >
              {{ metaobjects.landing_page.main.button_b }}
            </span>
            <div class="button__icons">
              <span class="button__icon">
                <svg
                  aria-hidden="true"
                  width="12"
                  height="12"
                  viewBox="0 0 12 12"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                  style="color: rgb(255, 64, 20);"
                >
                  <path d="M1.5 10.5011L10.2421 1.75789M2.46394 1.05078H10.9492V9.53606" stroke="currentColor" stroke-width="1.4" stroke-linecap="square"></path>
                </svg>
              </span>
              <span class="button__icon button__icon--2">
                <svg
                  aria-hidden="true"
                  width="12"
                  height="12"
                  viewBox="0 0 12 12"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                  style="color: rgb(255, 64, 20);"
                >
                  <path d="M1.5 10.5011L10.2421 1.75789M2.46394 1.05078H10.9492V9.53606" stroke="currentColor" stroke-width="1.4" stroke-linecap="square"></path>
                </svg>
              </span>
            </div>
          </div>
          <span
            class="animated-button-circle"
            style="transform-origin: 13.119795% 126.875%; background-color: #f5f5f7;"
          ></span>
        </a>
      </div>
    </div>
    {% assign images = metaobjects.landing_page.main.images.value %}
    {% assign count = images | size %}
    {% assign step = 1.5 %}
    {% assign total = count | times: step %}
    <div class="home__content">
      <div class="home__control--stack">
        <div class="home__control--buttons">
          <input class="home__control--radio" type="radio" name="control-panels" id="none">
          <label class="home__control--button" for="none">
            <svg class="home__control--icon" viewBox="0 0 36 36" width="36" height="36" aria-hidden="true">
              <g transform="translate(18 18) scale(0.952381) translate(-10.5 -10.5)">
                <path d="m12.12 10 4.07-4.06a1.5 1.5 0 1 0-2.11-2.12L10 7.88 5.94 3.81a1.5 1.5 0 1 0-2.12 2.12L7.88 10l-4.07 4.06a1.5 1.5 0 0 0 0 2.12 1.51 1.51 0 0 0 2.13 0L10 12.12l4.06 4.07a1.45 1.45 0 0 0 1.06.44 1.5 1.5 0 0 0 1.06-2.56Z"></path>
              </g>
            </svg>
          </label>
          <button class="home__control--button" type="button" aria-label="Scroll up" data-label="up">
            <svg class="home__control--icon" id="chevronup" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 36 36">
              <path d="m11 20c0-.3838.1465-.7676.4395-1.0605l5.5-5.5c.5854-.5859 1.5356-.5859 2.1211 0l5.5 5.5c.5859.5859.5859 1.5352 0 2.1211-.5854.5859-1.5356.5859-2.1211 0l-4.4395-4.4395-4.4395 4.4395c-.5854.5859-1.5356.5859-2.1211 0-.293-.293-.4395-.6768-.4395-1.0605z"></path>
            </svg>
          </button>
          <button class="home__control--button" type="button" aria-label="Scroll down" data-label="down">
            <svg class="home__control--icon" id="chevrondown" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 36 36">
              <path d="m25 16c0 .3838-.1465.7676-.4395 1.0605l-5.5 5.5c-.5854.5859-1.5356.5859-2.1211 0l-5.5-5.5c-.5859-.5859-.5859-1.5352 0-2.1211.5854-.5859 1.5356-.5859 2.1211 0l4.4395 4.4395 4.4395-4.4395c.5854-.5859 1.5356-.5859 2.1211 0 .293.293.4395.6768.4395 1.0605z"></path>
            </svg>
          </button>
        </div>
        <ul class="home__control--group">
          {% for panel in metaobjects.landing_page.main.control_panels.value %}
            <li class="home__control--item">
              <div class="home__control--radio-container">
                <input
                  class="home__control--radio {% if forloop.first %}is-first{%  elsif forloop.last %}is-last{% endif %}"
                  type="radio"
                  name="control-panels"
                  id="{{ panel.label | handleize }}"
                >

                <label class="home__control--label" for="{{ panel.label | handleize }}">
                  <svg
                    class="plus-icon"
                    version="1.1"
                    width="24px"
                    height="24px"
                    viewBox="0 0 24 24"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <circle cx="12" cy="12" r="11.3" style="stroke: rgb(0, 113, 227); fill: rgb(0, 113, 227);"></circle>
                    <g transform="translate(7 7)" style="stroke: none; fill: #fff; opacity: .8;">
                    <path d="m9 4h-3v-3c0-0.553-0.447-1-1-1s-1 0.447-1 1v3h-3c-0.553 0-1 0.447-1 1s0.447 1 1 1h3v3c0 0.553 0.447 1 1 1s1-0.447 1-1v-3h3c0.553 0 1-0.447 1-1s-0.447-1-1-1"></path>
                    </g>
                  </svg>
                  <span class="home__control--title">
                    {{ panel.label }}
                  </span>
                </label>
                <div class="home__control--panel">
                  <span
                    ><span class="panel-highlighted">{{ panel.highlighted }}</span> {{ panel.normal -}}
                  </span>
                </div>
              </div>
            </li>
          {% endfor %}
        </ul>
      </div>
      <div
        class="unit__image css-image-animation is-animated"
        data-unit-image
        style="--total: {{ total }}s; --step: {{ step }}s;"
      >
        <!-- MAIN (your current slideshow) -->
        <a
          href="{{ routes.collections_url }}/{{ metaobjects.landing_page.main.collection.value.handle }}"
          aria-label="{{ metaobjects.landing_page.main.button_a }}"
        >
          <div class="home__main-images" data-main-images>
            {% for item in images %}
              {% assign img = item.preview_image | default: item %}
              <img
                class="home__main-image"
                src="{{ img | image_url: height: 744 }}"
                alt="{{ img.alt | default: '' | escape }}"
                width="803"
                height="744"
                style="animation-delay: {{ forloop.index0 | times: step }}s;"
                {% if forloop.first %}
                  fetchpriority="high"
                  loading="eager"
                {% else %}
                  fetchpriority="low"
                  loading="lazy"
                {% endif %}
              >
            {% endfor %}
          </div>
        </a>

        <!-- PANEL IMAGES (one per radio/panel) -->
        <div class="home__panel-images" data-panel-images>
          {% for panel in metaobjects.landing_page.main.control_panels.value %}
            {% assign panel_id = panel.label | handleize %}
            {% if panel.image %}
              <img
                class="home__panel-image"
                data-panel-image="{{ panel_id }}"
                src="{{ panel.image | image_url: height: 744 }}"
                alt="{{ panel.image.alt | default: panel.label | escape }}"
                width="803"
                height="744"
                fetchpriority="low"
                loading="lazy"
              >
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>

