      font-size: 30px;
    }
  }
  .home__title--intro {
    text-align: center;
    margin-top: 14px;
    color: #1d1d1f;
  }
  .cta-links {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 13px;
    margin-top: 19px;
  }
  @media (max-width: 989px) {
    .home__unit--hero .home__content {
      touch-action: pan-y; /* allow vertical scroll, we handle horizontal */
      overscroll-behavior-x: contain;
    }
  }

  @media (max-width: 989px) {
    .home__control--radio-container,
    .home__unit--hero [data-unit-image] .home__main-images,
    .home__unit--hero [data-unit-image] .home__panel-images {
      transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
    }
  }
  .home__content {
    margin-top: 2.6rem;
    margin-left: 2rem;
    padding-right: 2rem;
    padding-bottom: 2rem;

    display: grid;
    grid-template-columns: minmax(0, 423px) minmax(0, 1fr);
    gap: 24px;
    align-items: start;

    grid-template-areas: 'list image';
  }

  .home__content .css-image-animation {
    grid-area: image;
    margin-top: 0;
  }

  @media (max-width: 989px) {
    .home__content {
      grid-template-columns: 1fr;
      grid-template-areas:
        'image'
        'list';
      padding-right: 0;
      margin-left: 0;
    }
  }
  .home__control--item {
    display: flex;
    flex: 0 0 auto;
    height: 56px;
    align-items: center;
    border-radius: 28px;
    margin-bottom: 12px;
  }
  .home__control--radio-container {
    display: flex;
    border-radius: 28px;
    background-color: #fff;
    height: 100%;
    align-items: center;
  }
  .home__control--radio-container:hover {
    background-color: rgba(232, 232, 237, 0.72);
  }
  .home__control--radio-container:has(.home__control--radio:checked):hover {
    background-color: #fff;
  }

  .home__control--radio {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .home__control--label {
    display: flex;
    padding-left: 14px;
    padding-right: 28px;
    padding-top: 14px;
    padding-bottom: 14px;
  }

  .home__control--panel {
    display: none;
    padding: 28px;
    font-size: 15px;
    line-height: 1.381002381;
    font-weight: 600;
    letter-spacing: 0.011em;
    color: #86868b;
  }

  .home__control--title {
    font-size: 17px;
    line-height: 1.235364;
    font-weight: 600;
    letter-spacing: -0.022em;
  }

  .home__control--radio:checked ~ .home__control--panel {
    display: block;
    animation: panelIn 180ms ease-out;
  }

  @keyframes panelIn {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .home__control--radio:checked + .home__control--label .plus-icon {
    opacity: 0;
    width: 0;
    margin: 0;
    overflow: hidden;
    white-space: nowrap;
    pointer-events: none;
  }

  .home__control--radio:checked + .home__control--label .control-title {
    opacity: 0;
    width: 0;
    margin: 0;
    overflow: hidden;
    white-space: nowrap;
    pointer-events: none;
  }

  .home__control--radio:checked + .home__control--label {
    opacity: 0;
    width: 0;
    margin: 0;
    padding: 0;
    overflow: hidden;
    white-space: nowrap;
    pointer-events: none;
  }

  .plus-icon {
    margin-right: 14px;
  }

  .panel-highlighted {
    color: #1d1d1f;
  }

  .home__control--group {
    margin: 0;

    display: flex;
    flex-direction: column;
    justify-content: flex-end;

    height: 428px;
    overflow: visible;
  }

  .home__control--item:has(.home__control--radio:checked) {
    height: auto;
    overflow: visible;
  }

  .home__control--stack {
    grid-area: list;
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 18px;
    align-items: start;
    justify-content: center;
  }

  @media (max-width: 989px) {
    .home__control--stack {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 989px) {
    .home__control--group > .home__control--item:first-child {
      margin-left: 2rem;
    }
  }

  .home__control--buttons {
    display: flex;
    flex-direction: column;
    gap: 12px;
    height: 428px;
    z-index: 2;
    justify-content: center;
  }

  .home__control--button {
    all: unset;
    cursor: pointer;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    color: #1d1d1f;
  }

  .home__control--icon {
    width: 36px;
    height: 36px;
    fill: currentColor;
    opacity: 0.95;
    border-radius: 50%;
    background-color: #fff;
    transition: background-color 160ms ease, transform 120ms ease;
  }

  @media (max-width: 989px) {
    .home__control--icon {
      width: 56px;
      background-color: rgb(0, 113, 227);
      fill: rgba(255, 255, 255, 0.8);
    }
  }

  .home__control--icon:hover {
    background-color: rgba(232, 232, 237, 0.72);
  }

  @media (max-width: 989px) {
    .home__control--icon:hover {
      background-color: rgb(0, 113, 227);
    }
  }

  @media (max-width: 989px) {
    .home__control--button[data-label='up'] .home__control--icon {
      border-radius: 0 0 28px 28px;
    }
  }

  @media (max-width: 989px) {
    .home__control--button[data-label='down'] .home__control--icon {
      border-radius: 28px 28px 0 0;
    }
  }

  .home__control--buttons {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 160ms ease, visibility 0s linear 160ms;
  }

  .home__control--stack:has(.home__control--group .home__control--radio:checked) .home__control--buttons {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition: opacity 160ms ease;
  }
  .home__control--stack:has(.home__control--radio.is-first:checked) .home__control--button[data-label='up'] {
    opacity: 0.25;
    pointer-events: none;
  }
  .home__control--stack:has(.home__control--radio.is-last:checked) .home__control--button[data-label='down'] {
    opacity: 0.25;
    pointer-events: none;
  }

  .home__panel-image {
    display: none;
    width: 100%;
    height: auto;
  }

  .unit__image[data-unit-image] .home__panel-images {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .css-image-animation.is-animated img.home__panel-image {
    position: static;
    animation: none !important;
    opacity: 1 !important;
    transform: none !important;

    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;

    display: none;
  }

  .unit__image.is-panel-active img.home__panel-image.is-active {
    display: block;
  }

  .unit__image.is-panel-active .home__main-images {
    display: none;
  }

  @media (max-width: 989px) {
    .home__control--stack {
      gap: 12px;
      justify-content: stretch;
    }

    .home__control--buttons {
      flex-direction: row;
      height: auto;
      justify-content: center;
    }

    .home__control--group {
      height: auto; /* no fixed height on mobile */
      overflow-x: auto;
      overflow-y: hidden;
      -webkit-overflow-scrolling: touch;
      display: flex;
      flex-direction: row;
      flex-wrap: nowrap;
      gap: 10px;
      justify-content: flex-start; /* NOT flex-end */
      padding-bottom: 6px; /* room for scrollbar */
      margin: 0;
    }

    .home__control--item {
      margin-bottom: 0;
      height: 56px;
      flex: 0 0 auto;
      scroll-snap-align: start;
    }

    /* keep the pill on one line and prevent label text wrapping */
    .home__control--label {
      white-space: nowrap;
    }

    /* Optional: hide scrollbar */
    .home__control--group::-webkit-scrollbar {
      height: 0;
    }
    .home__control--group {
      scrollbar-width: none;
    }

    .home__control--item:has(.home__control--radio:checked) {
      max-width: 100%;
    }
  }

  .home__content > * {
    min-width: 0;
  }
  .home__control--stack {
    min-width: 0;
  }
  .unit__image {
    min-width: 0;
  }

  @media (max-width: 989px) {
    .home__control--stack:has(.home__control--group .home__control--radio:checked):not(:has(#none:checked))
      .home__control--group {
      overflow-x: hidden;
      -webkit-overflow-scrolling: auto;
      scroll-snap-type: none;
      touch-action: pan-y;
    }
  }

  @media (min-width: 990px) {
    .home__control--radio:checked + .home__control--label .plus-icon {
      opacity: 0;
      width: 0;
      margin: 0;
      overflow: hidden;
      white-space: nowrap;
      pointer-events: none;
    }

    .home__control--radio:checked + .home__control--label .home__control--title {
      opacity: 0;
      width: 0;
      margin: 0;
      overflow: hidden;
      white-space: nowrap;
      pointer-events: none;
    }

    .home__control--radio:checked + .home__control--label {
      opacity: 0;
      width: 0;
      margin: 0;
      padding: 0;
      overflow: hidden;
      white-space: nowrap;
      pointer-events: none;
    }
  }

  @media (max-width: 989px) {
    /* OPEN state = any panel checked except #none */
    .home__control--stack:has(.home__control--group .home__control--radio:checked):not(:has(#none:checked))
      .home__control--group {
      overflow-x: hidden; /* no horizontal scroll */
      -webkit-overflow-scrolling: auto;
      scroll-snap-type: none;
      padding-bottom: 0;
      touch-action: pan-y;
    }

    .home__control--stack:has(.home__control--group .home__control--radio:checked):not(:has(#none:checked))
      .home__control--item {
      display: none;
    }

    .home__control--stack:has(.home__control--group .home__control--radio:checked):not(:has(#none:checked))
      .home__control--item:has(.home__control--radio:checked) {
      display: flex;
      width: 100%;
      flex: 0 0 100%;
      margin: 0;
    }

    .home__control--stack:has(.home__control--group .home__control--radio:checked):not(:has(#none:checked))
      .home__control--radio-container {
      width: 100%;
      max-width: 100%;
      box-sizing: border-box;
    }
  }

  @media (max-width: 989px) {
    /* OPEN state layout: [prev] [panel] [next], with a top row for the X */
    .home__control--stack:has(.home__control--group .home__control--radio:checked):not(:has(#none:checked)) {
      display: grid;
      grid-template-columns: 25px minmax(0, 1fr) 25px;
      grid-template-rows: auto;
      gap: 0;
      min-height: 140px;
      align-items: stretch;
      position: relative;
    }

    /* panel goes in the middle, second row */
    .home__control--stack:has(.home__control--group .home__control--radio:checked):not(:has(#none:checked))
      .home__control--group {
      grid-column: 2;
      grid-row: 1;
    }

    /* buttons overlay the same grid area, but don't block the panel */
    .home__control--stack:has(.home__control--group .home__control--radio:checked):not(:has(#none:checked))
      .home__control--buttons {
      grid-column: 1 / -1;
      grid-row: 1 / -1;

      display: grid;
      grid-template-columns: 25px minmax(0, 1fr) 25px;
      grid-template-rows: 1fr;

      z-index: 10;
      pointer-events: none;
      opacity: 1;
      visibility: visible;
    }

    .home__control--stack:has(.home__control--group .home__control--radio:checked):not(:has(#none:checked))
      .home__control--buttons
      > * {
      pointer-events: auto;
      position: static;
      transform: none;
    }

    .home__control--stack:has(.home__control--group .home__control--radio:checked):not(:has(#none:checked))
      .home__control--buttons
      > label.home__control--button {
      grid-column: 1;
      grid-row: 1; /* <- same row as the UP button */
      justify-self: start;
      align-self: start; /* <- top inside that cell */
    }

    /* prev/next always on the bottom of the panel row */
    .home__control--stack:has(.home__control--group .home__control--radio:checked):not(:has(#none:checked))
      .home__control--buttons
      > button[data-label='up'] {
      grid-column: 1;
      grid-row: 1;
      justify-self: start;
      align-self: end;
    }

    .home__control--stack:has(.home__control--group .home__control--radio:checked):not(:has(#none:checked))
      .home__control--buttons
      > button[data-label='down'] {
      grid-column: 3;
      grid-row: 1;
      justify-self: end;
      align-self: end;
    }

    .home__control--stack:has(.home__control--group .home__control--radio:checked):not(:has(#none:checked))
      button[data-label='up']
      .home__control--icon {
      transform: rotate(-90deg);
    }

    .home__control--stack:has(.home__control--group .home__control--radio:checked):not(:has(#none:checked))
      button[data-label='down']
      .home__control--icon {
      transform: rotate(-90deg);
    }
  }

  @media (max-width: 989px) {
    .home__control--stack:has(.home__control--group .home__control--radio:checked):not(:has(#none:checked))
      .home__control--buttons
      > label.home__control--button,
    .home__control--stack:has(.home__control--group .home__control--radio:checked):not(:has(#none:checked))
      .home__control--buttons
      > button[data-label='up'] {
      margin-left: -30px;
    }

    .home__control--stack:has(.home__control--group .home__control--radio:checked):not(:has(#none:checked))
      .home__control--buttons
      > button[data-label='down'] {
      margin-right: -18px;
    }
  }

  @media (max-width: 989px) {
    label.home__control--button[for='none'] > .home__control--icon {
      width: 36px;
      height: 56px;
      border-radius: 0 28px 28px 0;
    }
  }
  .home__control--buttons,
  .home__control--group {
    min-width: 0;
  }

  @media (max-width: 989px) {
    .home__control--stack {
      width: 100%;
      min-width: 0;
