{% javascript %}
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.home__control--stack').forEach((stack) => {
      const list = stack.querySelector('.home__control--group');
      const btnUp = stack.querySelector('.home__control--button[data-label="up"]');
      const btnDown = stack.querySelector('.home__control--button[data-label="down"]');
      if (!list || !btnUp || !btnDown) return;

      const radios = Array.from(list.querySelectorAll('input.home__control--radio[type="radio"]'));

      const getCheckedIndex = () => radios.findIndex((r) => r.checked);

      const setChecked = (idx) => {
        if (idx < 0 || idx >= radios.length) return;
        radios[idx].checked = true;
        radios[idx].dispatchEvent(new Event('change', { bubbles: true }));
      };

      btnDown.addEventListener('click', () => {
        const i = getCheckedIndex();
        // if none selected yet -> select first
        setChecked(i === -1 ? 0 : Math.min(i + 1, radios.length - 1));
      });

      btnUp.addEventListener('click', () => {
        const i = getCheckedIndex();
        // if none selected yet -> select last
        setChecked(i === -1 ? radios.length - 1 : Math.max(i - 1, 0));
      });
    });
  });
  document.addEventListener('DOMContentLoaded', () => {
    const unit = document.querySelector('[data-unit-image]');
    const group = document.querySelector('.home__control--group');
    if (!unit || !group) return;

    const noneRadio = document.getElementById('none'); // your "reset" radio
    const radios = Array.from(group.querySelectorAll('input.home__control--radio[type="radio"]'));
    const panelImgs = Array.from(unit.querySelectorAll('.home__panel-image'));

    function showMain() {
      unit.classList.remove('is-panel-active');
      panelImgs.forEach((img) => img.classList.remove('is-active'));
    }

    function showPanel(panelId) {
      const img = unit.querySelector(`.home__panel-image[data-panel-image="${panelId}"]`);
      if (!img) return showMain();

      unit.classList.add('is-panel-active');
      panelImgs.forEach((i) => i.classList.toggle('is-active', i === img));
    }

    // panel radios
    radios.forEach((r) => {
      r.addEventListener('change', () => {
        if (!r.checked) return;
        // prefer data-panel if you add it; fallback to id
        const panelId = r.dataset.panel || r.id;
        showPanel(panelId);
      });
    });

    // none -> back to slideshow
    if (noneRadio) {
      noneRadio.addEventListener('change', () => {
        if (noneRadio.checked) showMain();
      });
    }

    // initial state
    const checked = radios.find((r) => r.checked);
    if (checked) showPanel(checked.dataset.panel || checked.id);
    else showMain();
  });

  document.addEventListener('DOMContentLoaded', () => {
    const mq = window.matchMedia('(max-width: 989px)');

    // tuning
    const DOMINANCE = 1.1; // horizontal must dominate vertical
    const LOCK_PX = 10; // px before we lock direction
    const DRAG_MAX = 0.35; // max drag = 35% of panel width
    const TRIGGER_PROGRESS = 0.55; // trigger when you dragged 55% of max

    // image + panel sync
    const IMAGE_RATIO = 1.0; // 1.0 = perfectly in sync with panel
    const FADE_MAX_IMG = 0.18; // image fades up to 18% while dragging
    const FADE_MAX_PANEL = 0.12; // panel fades up to 12% while dragging
    const OUT_FADE_IMG = 0.25; // fade when completing swipe
    const OUT_FADE_PANEL = 0.2;

    const supportsPointer = 'PointerEvent' in window;

    function attachDragSwipe(surface, opts) {
      if (!surface) return;

      let sx = 0,
        sy = 0,
        tracking = false;
      let locked = null; // 'x' or 'y'
      let activeEl = null;
      let activeImgEls = [];

      const clamp = (v, min, max) => Math.max(min, Math.min(v, max));

      const getPoint = (e) => {
        if (e.touches && e.touches.length) return e.touches[0];
        if (e.changedTouches && e.changedTouches.length) return e.changedTouches[0];
        return e;
      };

      const setPanel = (x, opacity) => {
        if (!activeEl) return;
        activeEl.style.transform = `translateX(${x}px)`;
        activeEl.style.opacity = String(opacity);
      };

      const setImage = (x, opacity) => {
        if (!activeImgEls.length) return;
        activeImgEls.forEach((el) => {
          el.style.transform = `translateX(${x}px)`;
          el.style.opacity = String(opacity);
        });
      };

      const clearAll = () => {
        if (activeEl) {
          activeEl.style.transition = '';
          activeEl.style.transform = '';
          activeEl.style.opacity = '';
          activeEl.style.willChange = '';
        }
        activeImgEls.forEach((el) => {
          el.style.transition = '';
          el.style.transform = '';
          el.style.opacity = '';
          el.style.willChange = '';
        });
        activeEl = null;
        activeImgEls = [];
        locked = null;
      };

      const start = (e) => {
        if (!opts.enabled()) return;

        // ignore mouse/trackpad
        if (supportsPointer && e.pointerType === 'mouse') return;

        // ignore pinch
        if (e.touches && e.touches.length > 1) return;

        activeEl = opts.getActiveEl();
        activeImgEls = opts.getImageEls();
        if (!activeEl) return;

        const p = getPoint(e);
        sx = p.clientX;
        sy = p.clientY;
        tracking = true;
        locked = null;

        activeEl.style.willChange = 'transform, opacity';
        activeEl.style.transition = 'none';

        activeImgEls.forEach((el) => {
          el.style.willChange = 'transform, opacity';
          el.style.transition = 'none';
        });

        if (supportsPointer && surface.setPointerCapture && e.pointerId != null) {
          try {
            surface.setPointerCapture(e.pointerId);
          } catch (_) {}
        }
      };

      const move = (e) => {
        if (!tracking || !activeEl) return;
        if (!opts.enabled()) return;

        const p = getPoint(e);
        const dx = p.clientX - sx;
        const dy = p.clientY - sy;

        // direction lock
        if (!locked) {
          if (Math.abs(dx) < LOCK_PX && Math.abs(dy) < LOCK_PX) return;
          locked = Math.abs(dx) >= Math.abs(dy) ? 'x' : 'y';
        }

        // if horizontal intent, stop page scroll (touch only)
        if (locked === 'x' && e.cancelable) e.preventDefault();
        if (locked !== 'x') return;

        const w = activeEl.getBoundingClientRect().width || 1;
        const max = w * DRAG_MAX;

        const clampedDx = clamp(dx, -max, max);
        const progress = Math.min(1, Math.abs(clampedDx) / max);

        setPanel(clampedDx, 1 - progress * FADE_MAX_PANEL);
        setImage(clampedDx * IMAGE_RATIO, 1 - progress * FADE_MAX_IMG);
      };

      const end = (e) => {
        if (!tracking) return;
        tracking = false;

        if (!opts.enabled() || !activeEl) {
          clearAll();
          return;
        }

        // if vertical scroll gesture, abort
        if (locked === 'y') {
          clearAll();
          return;
        }

        const p = getPoint(e);
        const dx = p.clientX - sx;
        const dy = p.clientY - sy;

        const horizontalEnough = Math.abs(dx) > Math.abs(dy) * DOMINANCE;

        const w = activeEl.getBoundingClientRect().width || 1;
        const max = w * DRAG_MAX;
        const clampedDx = clamp(dx, -max, max);
        const progress = Math.min(1, Math.abs(clampedDx) / max);

        const isSwipe = horizontalEnough && progress >= TRIGGER_PROGRESS;

        const OUT = w + 40;

        const snapBack = () => {
          activeEl.style.transition = 'transform 180ms ease, opacity 180ms ease';
          setPanel(0, 1);

          activeImgEls.forEach((el) => {
            el.style.transition = 'transform 180ms ease, opacity 180ms ease';
          });
          setImage(0, 1);

          activeEl.addEventListener('transitionend', clearAll, { once: true });
        };

        if (!isSwipe) return snapBack();

        const left = dx < 0;
        if (left && !opts.canNext()) return snapBack();
        if (!left && !opts.canPrev()) return snapBack();

        // slide current out (panel + image)
        activeEl.style.transition = 'transform 180ms ease, opacity 180ms ease';
        setPanel(left ? -OUT : OUT, 1 - OUT_FADE_PANEL);

        activeImgEls.forEach((el) => {
          el.style.transition = 'transform 180ms ease, opacity 180ms ease';
        });
        setImage((left ? -OUT : OUT) * IMAGE_RATIO, 1 - OUT_FADE_IMG);

        activeEl.addEventListener(
          'transitionend',
          () => {
            // trigger your existing logic (buttons)
            if (left) opts.goNext();
            else opts.goPrev();

            // animate incoming panel + image in
            requestAnimationFrame(() => {
              const incomingPanel = opts.getActiveEl();
              const incomingImgs = opts.getImageEls();
              const OUT2 = OUT;

              if (incomingPanel) {
                incomingPanel.style.willChange = 'transform, opacity';
                incomingPanel.style.transition = 'none';
                incomingPanel.style.transform = `translateX(${left ? OUT2 : -OUT2}px)`;
                incomingPanel.style.opacity = String(1 - OUT_FADE_PANEL);
              }

              incomingImgs.forEach((el) => {
                el.style.willChange = 'transform, opacity';
                el.style.transition = 'none';
                el.style.transform = `translateX(${(left ? OUT2 : -OUT2) * IMAGE_RATIO}px)`;
                el.style.opacity = String(1 - OUT_FADE_IMG);
              });

              // force reflow
              incomingPanel && incomingPanel.getBoundingClientRect();

              if (incomingPanel) {
                incomingPanel.style.transition = 'transform 200ms ease, opacity 200ms ease';
                incomingPanel.style.transform = 'translateX(0px)';
                incomingPanel.style.opacity = '1';
              }

              incomingImgs.forEach((el) => {
                el.style.transition = 'transform 200ms ease, opacity 200ms ease';
                el.style.transform = 'translateX(0px)';
                el.style.opacity = '1';
              });

              const cleanup = () => {
                if (incomingPanel) {
                  incomingPanel.style.transition = '';
                  incomingPanel.style.transform = '';
                  incomingPanel.style.opacity = '';
                  incomingPanel.style.willChange = '';
                }
                incomingImgs.forEach((el) => {
                  el.style.transition = '';
                  el.style.transform = '';
                  el.style.opacity = '';
                  el.style.willChange = '';
                });
              };

              if (incomingPanel) incomingPanel.addEventListener('transitionend', cleanup, { once: true });
              else setTimeout(cleanup, 220);
            });

            clearAll();
          },
          { once: true }
        );
      };

      const cancel = () => {
        tracking = false;
        clearAll();
      };

      if (supportsPointer) {
        surface.addEventListener('pointerdown', start, { passive: true });
        surface.addEventListener('pointermove', move, { passive: true }); // pointer uses touch-action
        surface.addEventListener('pointerup', end, { passive: true });
        surface.addEventListener('pointercancel', cancel, { passive: true });
      } else {
        surface.addEventListener('touchstart', start, { passive: true });
        surface.addEventListener('touchmove', move, { passive: false }); // preventDefault needs passive:false
        surface.addEventListener('touchend', end, { passive: true });
        surface.addEventListener('touchcancel', cancel, { passive: true });
      }
    }

    document.querySelectorAll('.home__control--stack').forEach((stack) => {
      const group = stack.querySelector('.home__control--group');
      const btnUp = stack.querySelector('.home__control--button[data-label="up"]');
      const btnDown = stack.querySelector('.home__control--button[data-label="down"]');
      const noneRadio = stack.querySelector('#none');

      if (!group || !btnUp || !btnDown) return;

      const radios = Array.from(group.querySelectorAll('input.home__control--radio[type="radio"]'));
      if (!radios.length) return;

      const hero = stack.closest('.home__unit--hero');
      const unit = hero ? hero.querySelector('[data-unit-image]') : null;

      // one surface covers image + gap + panel
      const surface = stack.closest('.home__content');

      const getCheckedIndex = () => radios.findIndex((r) => r.checked);

      const enabled = () => {
        if (!mq.matches) return false;
        if (noneRadio && noneRadio.checked) return false;
        return getCheckedIndex() !== -1;
      };

      const getActiveEl = () => {
        const checked = radios.find((r) => r.checked);
        return checked ? checked.closest('.home__control--radio-container') : null;
      };

      const getImageEls = () => {
        if (!unit) return [];
        const panel = unit.querySelector('.home__panel-images');
        return [panel].filter(Boolean);
      };

      const canNext = () => {
        const i = getCheckedIndex();
        return i !== -1 && i < radios.length - 1;
      };

      const canPrev = () => {
        const i = getCheckedIndex();
        return i > 0;
      };

      const goNext = () => btnDown.click();
      const goPrev = () => btnUp.click();

      // cleanup if user taps/changes
      radios.forEach((r) =>
        r.addEventListener('change', () => {
          const el = getActiveEl();
          if (el) {
            el.style.transition = '';
            el.style.transform = '';
            el.style.opacity = '';
            el.style.willChange = '';
          }
          getImageEls().forEach((im) => {
            im.style.transition = '';
            im.style.transform = '';
            im.style.opacity = '';
            im.style.willChange = '';
          });
        })
      );

      attachDragSwipe(surface, { enabled, getActiveEl, getImageEls, canNext, canPrev, goNext, goPrev });
    });
  });
{% endjavascript %}

