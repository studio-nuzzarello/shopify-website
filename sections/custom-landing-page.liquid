{% style %}
  .css-image-animation {
    position: relative;
    overflow: hidden;
    height: 372px;
    max-height: 372px;
    width: 100%;
    margin-top: 2.6rem;

    /* center static (non-animated) single image nicely */
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .css-image-animation img {
    /* STATIC default */
    position: static;
    max-height: 100%;
    max-width: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    opacity: 1;
    transform: none;
    border-radius: 0 0 20px 20px;
  }

.css-image-animation.is-animated .home__main-image {
  position: absolute;
  inset: 0;
  margin: auto;

  max-width: 100%;
  max-height: 100%;
  width: auto;
  height: auto;
  object-fit: contain;

  opacity: 0;
  animation: heroCycleDyn var(--total, 12s) infinite;
  will-change: opacity;
}


@keyframes heroCycleDyn {
  0%   { opacity: 1; }
  40%  { opacity: 1; }
  55%  { opacity: 0; }
  100% { opacity: 0; }
}

@media (prefers-reduced-motion: reduce) {
  .css-image-animation.is-animated .home__main-image {
    animation: none;
    opacity: 0;
  }
  .css-image-animation.is-animated .home__main-image:first-child {
    opacity: 1;
  }
}


  .home-section {
    max-width: 980px;
    padding-top: 12px;
    margin: auto;
    text-align: start;
    margin-bottom: 12px;
    background-color: #fff;

    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px; /* adjust spacing between cards */
  }

  .home__unit--hero {
    grid-column: 1 / -1; /* full width row */
  }

  .home__unit {
    background: #f5f5f7;
    border-radius: 20px;
  }

  @media (max-width: 989px) {
    .home-section {
      padding-left: 2rem;
      padding-right: 2rem;
      grid-template-columns: 1fr;
    }
    .home__unit--hero {
      grid-column: auto; /* not strictly required, but fine */
    }
  }

  .home__unit--copy {
    padding-top: 47px;
    padding-left: 2rem;
    padding-right: 2rem;
    padding-bottom: 5rem;
  }
  @media (max-width: 989px) {
    .home__unit--copy {
      padding-bottom: 0;
    }
  }
  .home__title {
    font-size: 40px;
    line-height: 1.07143;
    letter-spacing: -0.005em;
    text-align: center;
    color: #1d1d1f;
  }
  @media (max-width: 989px) {
