{% style %}
.shopify-section:not(:first-child).contact-section {
  --header-height: 0px;
}

.shopify-section:not(:first-child).contact-section,
.shopify-section:first-child.contact-section.not-margin {
  --header-height: 0px;
}

/* big country select */
.contact-form__select--large {
  min-height: 5.4rem;
  padding-top: 1.6rem;
  padding-bottom: 1.2rem;
}

/* address group spacing (prevents weird margins) */
.contact-form__address-group {
  margin-top: 0.4rem;
}

.contact-form__address-group .field {
  margin-bottom: 0;
}

.contact-form__address-group .contact-form__grid-2 + .contact-form__grid-2 {
  margin-top: 0.8rem;
}


.contact-form__grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.8rem;
}


.contact-form__address-block .field {
  margin-bottom: 0.8rem;
}
.contact-form__address-block .contact-form__grid-2 .field {
  margin-bottom: 0;
}


.contact-form__group {
  margin-top: 0.4rem;
}


.contact-form {
  position: relative;
}

.contact__form--container {
    max-width: 1140px;
    margin: 0 auto;
    padding-left: 8rem;
    padding-right: 8rem;
    margin-top: 40px;
    padding-bottom: 40px;
  }
@media (max-width: 989px) {
    .contact__form--container {
      padding-left: 2rem;
      padding-right: 2rem;
      margin-top: 60px;
    }
  }
.contact-form__titles {
  position: relative;
  z-index: 3;
}
.contact-form__description {
  position: relative;
  z-index: 3;
}
.contact-form__inner {
  display: flex;
  justify-content: flex-start;
}
.contact-form__inner--right {
  justify-content: flex-end;
}
.contact-form__inner--center {
  justify-content: center;
}
.contact-form__wrapper {
  position: relative;
  flex: none;
  width: min(41.6rem, 100%);
  z-index: 3;
}
.contact-form__title-form {
  margin: 0 0 1.2rem 0;
}
.contact-form__title-form > p {
  margin: 0;
}
.contact-form__text-form {
  margin: 0;
  margin-bottom: 2.4rem;
  color: rgb(var(--color-foreground-secondary));
}
.contact-form .field__label span {
  color: rgb(var(--color-error));
}
.contact-form .contact-form__field-error .form__message {
  align-items: flex-start;
  margin: 1rem 0 0;
  font-size: 1.2rem;
  font-weight: var(--font-body-weight);
  color: rgba(var(--color-error));
}
.contact-form .contact-form__field-error .form__message:before {
  content: "*";
  color: rgba(var(--color-error));
  margin-right: 0.2rem;
}
@media screen and (min-width: 750px) {
  .contact-form__fields {
    display: flex;
    grid-column-gap: 0.8rem;
  }
}
.contact-form .field {
  margin-bottom: 2rem;
}
.contact-form .text-area {
  min-height: 8.8rem;
}
.contact-form__bottom {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1.6rem;
  margin-top: 2.4rem;
}
@media screen and (min-width: 750px) {
  .contact-form__bottom {
    margin-top: 3.2rem;
  }
}
.contact-form__add-text {
  max-width: 35.5rem;
  color: rgb(var(--color-foreground-secondary));
  text-align: center;
}
.contact-form__add-text a {
  display: inline;
  color: rgba(var(--color-foreground-secondary));
  transition: background-size var(--duration-default) ease-in-out, opacity var(--duration-default) ease-in-out;
  background-position: left 100%;
  background-size: 100% 5%;
  background-image: linear-gradient(to right, rgba(var(--color-foreground-secondary)) 0%, rgba(var(--color-foreground-secondary)) 100%);
  background-repeat: no-repeat;
  text-decoration: none;
}
@media screen and (pointer: fine) {
  .contact-form__add-text a:hover {
    background-size: 0% 5%;
    background-position: right 100%;
    opacity: var(--hover-opacity);
  }
}
.contact-form__add-text > * {
  margin: 0;
}
.contact-form .icon-success {
  margin-top: 0.2rem;
}
.contact-form__image {
  position: absolute;
  inset: 0;
  display: block;
  max-width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: 1;
}
.contact-form__overlay {
  position: absolute;
  inset: 0;
  z-index: 2;
  background-color: rgb(var(--color-overlay));
  opacity: var(--opacity-slide);
}
.grecaptcha-badge {
  visibility: hidden;
}
.page__nav--wrapper {
    background-color: #fff;
  }
  .page__nav--headline {
    color: #1d1d1f;
    height: 25px;
    font-size: 21px;
    line-height: normal;
    font-weight: 600;
    letter-spacing: 0.231px;
    height: auto;
    margin: 0;

    flex: 1;
    min-width: 0;
  }
  @media screen and (max-width: 990px) {
    .page__nav--headline {
      font-size: 14px;
    }
  }
  .page__nav {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1140px;
    margin: 0 auto;
    padding-left: 8rem;
    padding-right: 8rem;
    min-height: 52px;
    height: auto;
  }
  @media (max-width: 989px) {
    .page__nav {
      padding-left: 2rem;
      padding-right: 2rem;
    }
  }
  .page__nav--border {
    border-bottom: 1px solid #d2d2d7;
  }
  .page--wrapper {
    background-color: #fff;
  }
  .page__custom {
    max-width: 1140px;
    margin: 0 auto;
    padding-left: 8rem;
    padding-right: 8rem;
    padding-top: 40px;
    padding-bottom: 40px;
  }
  @media (max-width: 989px) {
    .page__custom {
      padding-left: 2rem;
      padding-right: 2rem;
    }
  }
  .page__content * {
    color: #1d1d1f;
  }
  .page__content p {
    font-size: 17px;
    font-weight: 400;
    letter-spacing: -0.374px;
    line-height: 25px;
    margin-top: 13.6px;
  }
  .page__content h2 {
    padding-inline-end: 23px;
    font-size: 24px;
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: -0.0045em;
  }
  .page__content h3 {
    padding-inline-end: 23px;
    font-size: 20px;
    line-height: 1.25;
    font-weight: 650;
    letter-spacing: -0.003em;
  }
  .page__content ul {
    list-style: disc;
    text-align: start;
    list-style-position: outside;
    list-style-type: disc;
    margin-left: 2rem;
    padding-bottom: 1.3rem;
    padding-top: 1.3rem;
  }
  .page__content ol {
    list-style: decimal;
    text-align: start;
    list-style-position: outside;
    list-style-type: disc;
    margin-left: 2rem;
    padding-bottom: 1.3rem;
    padding-top: 1.3rem;
  }
{% endstyle %}

<div class="quicknav__container" style="background-color: #fff;">
  <div class="quicknav mobile-block">
    <h1 class="quicknav__category">{{ page.title | escape }}</h1>
    <p class="quicknav__intro">Individuelles Faltpavillon-Angebot in 24 Stunden erhalten</p>
  </div>
  <div class="quicknav__border"></div>
</div>


<div class="contact-form background contact__form--container">
  <div>
    {% render 'heading-group', section: section, class: 'contact-form', text_align: section.settings.text_align %}

    <div class="contact-form__inner contact-form__inner--center content">
      {% if section.settings.image != blank %}
        <span
          class="contact-form__overlay"
          style="--opacity-slide: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
        ></span>
        {%- capture sizes -%}
          (min-width: 1100px) 1920px, calc((100vw - 20px))
        {%- endcapture -%}
        {{
          section.settings.image
          | image_url: width: 1920
          | image_tag:
            loading: 'lazy',
            sizes: sizes,
            widths: '360, 533, 720, 940, 1066, 1200, 1400, 1600, 1800, 1920, 2000, 2200, 2400, 2600',
            class: 'contact-form__image'
        }}
      {% endif %}
      <div class="contact-form__wrapper">
        {%- if section.settings.heading_form != blank -%}
          <h2 class="contact-form__title-form {{ section.settings.heading_form_size }}">
            {{ section.settings.heading_form }}
          </h2>
        {%- endif -%}
        {%- if section.settings.text_form != blank -%}
          <p class="contact-form__text-form">
            {{ section.settings.text_form }}
          </p>
        {%- endif -%}
        {%- form 'contact', id: 'ContactForm' -%}
  {%- if form.posted_successfully? -%}
    <div class="form-status form-status-list form__message" tabindex="-1" autofocus>
      {% render 'icon-success' %}
      Angebotsanfrage erfolgreich übermittelt. Unser Team erstellt Ihr Angebot in Kürze und sendet es Ihnen per E-Mail zu.
    </div>
  {%- elsif form.errors -%}
  {%- endif -%}

  {%- assign customer_cc = '' -%}
{%- if customer and customer.default_address -%}
  {%- assign customer_cc = customer.default_address.country_code | upcase -%}
{%- endif -%}

<div class="field contact-form__group">
  <select
    id="ContactForm-country"
    class="field__input focus-inset contact-form__select--large"
    name="contact[Land]"
    aria-required="true"
    required
    autocomplete="shipping country-name"
  >
    <option value="Deutschland" {% if customer_cc == 'DE' or customer_cc == blank %}selected{% endif %}>Deutschland</option>
    <option value="Österreich" {% if customer_cc == 'AT' %}selected{% endif %}>Österreich</option>
    <option value="Schweiz" {% if customer_cc == 'CH' %}selected{% endif %}>Schweiz</option>
    <option value="Italien" {% if customer_cc == 'IT' %}selected{% endif %}>Italien</option>
  </select>

  <label class="field__label body-small" for="ContactForm-country">
    Land
  </label>
</div>


  <div class="field contact-form__group">
    <input
      id="ContactForm-product"
      class="field__input focus-inset"
      type="text"
      name="contact[Produkt]"
      placeholder="z. B. Faltpavillon 3x3 m"
      aria-required="true"
      required
    >
    <label class="field__label body-small" for="ContactForm-product">
      Produkt
    </label>
  </div>

  <div class="contact-form__address-group">
  <!-- Row 1: Adresse + Menge -->
  <div class="contact-form__grid-2">
    <div class="field">
      <input
        id="ContactForm-address"
        class="field__input focus-inset"
        type="text"
        name="contact[Adresse]"
        placeholder="Straße + Hausnummer"
        aria-required="true"
        required
        autocomplete="shipping address-line1"
        value="{% if customer and customer.default_address %}{{ customer.default_address.address1 }}{% endif %}"
      >
      <label class="field__label body-small" for="ContactForm-address">
        Adresse
      </label>
    </div>

    <div class="field">
      <input
        id="ContactForm-qty"
        class="field__input focus-inset"
        type="number"
        name="contact[Menge]"
        min="1"
        step="1"
        inputmode="numeric"
        placeholder="z. B. 1"
        aria-required="true"
        required
        autocomplete="off"
        value="1"
      >
      <label class="field__label body-small" for="ContactForm-qty">
        Menge
      </label>
    </div>
  </div>

  <!-- Row 2: PLZ + Ort -->
  <div class="contact-form__grid-2">
    <div class="field">
      <input
        id="ContactForm-postal"
        class="field__input focus-inset"
        type="text"
        name="contact[PLZ]"
        placeholder="PLZ"
        aria-required="true"
        required
        inputmode="numeric"
        autocomplete="shipping postal-code"
        value="{% if customer and customer.default_address %}{{ customer.default_address.zip }}{% endif %}"
      >
      <label class="field__label body-small" for="ContactForm-postal">
        PLZ
      </label>
    </div>

    <div class="field">
      <input
        id="ContactForm-city"
        class="field__input focus-inset"
        type="text"
        name="contact[Ort]"
        placeholder="Ort"
        aria-required="true"
        required
        autocomplete="shipping address-level2"
        value="{% if customer and customer.default_address %}{{ customer.default_address.city }}{% endif %}"
      >
      <label class="field__label body-small" for="ContactForm-city">
        Ort
      </label>
    </div>
  </div>
</div>




  <!-- 3) Anfragedetails -->
  <div class="field contact-form__group">
    <textarea
      id="ContactForm-details"
      class="text-area field__input"
      name="contact[Anfragedetails]"
      placeholder="Einsatz, Wunschliefertermin, Farbe, Bedruckung, Zubehör, Besonderheiten …"
      rows="6"
    ></textarea>
    <label class="field__label body-small" for="ContactForm-details">
      Anfragedetails
    </label>
  </div>
 
  <div class="contact-form__grid-2 contact-form__group">
    <div class="field field--with-error">
      <input
        autocomplete="email"
        type="email"
        dir="ltr"
        id="ContactForm-email"
        class="field__input focus-inset"
        name="contact[email]"
        spellcheck="false"
        autocapitalize="off"
        value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
        aria-required="true"
        {% if form.errors contains 'email' %}
          aria-invalid="true"
          aria-describedby="ContactForm-email-error"
        {% endif %}
        placeholder="{{- 'templates.contact.form.email' | t -}}"
        required
      >
      <label class="field__label body-small" for="ContactForm-email">
        {{- 'templates.contact.form.email' | t -}}
      </label>

      {%- if form.errors contains 'email' -%}
        <small class="contact-form__field-error" id="ContactForm-email-error">
          <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
          <span class="form__message">
            {{- form.errors.translated_fields.email | capitalize }}
            {{ form.errors.messages.email -}}
          </span>
        </small>
      {%- endif -%}
    </div>

    <div class="field">
      <input
        id="ContactForm-company"
        class="field__input focus-inset"
        type="text"
        name="contact[Firma]"
        placeholder="Firma oder Behörde"
        aria-required="true"
        required
        value="{% if customer and customer.default_address and customer.default_address.company != blank %}{{ customer.default_address.company }}{% endif %}"
      >
      <label class="field__label body-small" for="ContactForm-company">
        Firma/Behörde
      </label>
    </div>
  </div>

  <div class="field contact-form__group">
    <input
        id="ContactForm-contact-person"
        class="field__input focus-inset"
        type="text"
        name="contact[Ansprechpartner]"
        placeholder="Vor- und Nachname (optional)"
        autocomplete="name"
        value="{% if customer %}{% if customer.first_name != blank %}{{ customer.first_name }}{% endif %}{% if customer.last_name != blank %} {{ customer.last_name }}{% endif %}{% endif %}"
    >
    <label class="field__label body-small" for="ContactForm-contact-person">
        Ansprechpartner/in (optional)
    </label>
    </div>


  <div class="contact-form__bottom">
    <button type="submit" class="button button--primary focus-inset" style="background-color: rgb(0, 118, 223);">
      <div class="button__content">
        <span class="button__label" data-label="Angebot anfragen">
          Angebot anfragen
        </span>
      </div>
    </button>

    {% if section.settings.additional_text != blank %}
      <div class="contact-form__add-text body-small">
        {{- section.settings.additional_text -}}
      </div>
    {% endif %}
  </div>
{%- endform -%}

      </div>
    </div>
  </div>
</div>


<div class="page--wrapper">
  <div class="page__custom">
    <div class="page__content">{{ page.content }}</div>
  </div>
</div>

{% schema %}
{
  "name": "Custom Offer Contact Form",
  "tag": "section",
  "class": "custom-offer-contact-form",
  "settings": [],
  "presets": [
    {
      "name": "Custom Offer Contact Form"
    }
  ]
}
{% endschema %}