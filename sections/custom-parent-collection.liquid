{% for collection in collection.metafields.custom.sub_categories.value %}
  {% capture slides %}
    {% for product in collections[collection.handle].products %}
        {% render 'slide',
          product: product
        %}
    {% endfor %}
  {% endcapture %}

  {% assign trimmed_slides = slides | strip %}

  {% unless trimmed_slides == '' %}
    <div class="collection__wrapper">
      <div class="slides__wrapper">
        <h2 class="slides__title">{{ collection.title }}</h2>
        <p class="slides__subtitle"></p>
      </div>
      <div class="slides__all">
        {{ slides }}
      </div>
    </div>
  {% endunless %}
{% endfor %}

{% style %}
  .collection__wrapper {
    background-color: #f5f5f7;
  }
{% endstyle %}

{% schema %}
{
  "name": "Parent Collection",
  "tag": "section",
  "class": "parent-collection-section",
  "settings": [],
  "presets": [
    {
      "name": "Parent Collection"
    }
  ]
}
{% endschema %}
