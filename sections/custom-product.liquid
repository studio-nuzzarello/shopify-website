                            data-variant-id="{{ layer.variant.value.id }}"
                            data-variant-price="{{ layer.variant.value.price }}"
                            data-persistence-code="{{ layer.persistence_code }}"
                            value="{{ layer.position | handle }}-{{ layer.variant.value.id }}"
                          >
                            {{ layer.title }} – {{ layer.variant.value.price | money }}
                          </option>
                        {% endfor %}
                      </optgroup>
                    {% endif %}

                    {% if printed_layers.size > 0 %}
                      <optgroup label="Bedruckt">
                        <option value="">Ohne</option>
                        {% for layer in printed_layers %}
                          <option
                            data-variant-id="{{ layer.variant.value.id }}"
                            data-variant-price="{{ layer.variant.value.price }}"
                            data-persistence-code="{{ layer.persistence_code }}"
                            value="{{ layer.position | handle }}-{{ layer.variant.value.id }}"
