        "image": [{{ product.featured_image | image_url: width: 1200 | prepend: 'https:' | json }}],
        {%- endif -%}
        "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
        {%- if product.metafields.custom.size -%}
        "size": {{ product.metafields.custom.size | json }},
        {% endif %}
        {%- if usps != blank and usps.size > 0 -%}
