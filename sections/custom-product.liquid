      display: block;
    }
  }
  @supports (animation-timeline: scroll()) {
    @media (max-width: 989px) {
      .product__header .price-quick-row .product__quickbuy {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;

        animation-name: quickbuyToggle;
        animation-timing-function: linear;
        animation-fill-mode: both;

        animation-timeline: scroll(root);
        animation-range: 0px 80px;
      }

      .product__header.no-usps .price-quick-row .product__quickbuy {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
        animation: none;
      }
    }
  }

  @keyframes quickbuyToggle {
    0%,
    74.9% {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }
    75%,
    100% {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }
  }

