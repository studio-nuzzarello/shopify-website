        {%- endif -%}

        {%- assign bc = variant.barcode | strip -%}
        {%- if bc != blank -%}
          {%- assign bc_len = bc | size -%}
          {%- if bc_len == 8 -%}
        "gtin8": {{ bc | json }},
          {%- elsif bc_len == 12 -%}
        "gtin12": {{ bc | json }},
          {%- elsif bc_len == 13 -%}
        "gtin13": {{ bc | json }},
          {%- elsif bc_len == 14 -%}
        "gtin14": {{ bc | json }},
          {%- endif -%}
        {%- endif -%}

        {%- if variant.featured_image -%}
        "image": [{{ variant.featured_image | image_url: width: 1200 | prepend: 'https:' | json }}],
        {%- elsif product.featured_image -%}
        "image": [{{ product.featured_image | image_url: width: 1200 | prepend: 'https:' | json }}],
        {%- endif -%}

        "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },

        "offers": {
