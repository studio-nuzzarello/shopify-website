    display: flex;
    gap: 4vw;
    overflow-x: scroll;
    scroll-snap-type: x mandatory;
    scroll-behavior: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .product__gallery-scroll::-webkit-scrollbar {
    display: none;
  }
  /* Show arrows when hovering the scroll area */
  .product__gallery:hover .product__gallery-arrow,
  .product__gallery-scroll:hover ~ .product__gallery-arrow {
    opacity: 1;
    pointer-events: auto;
  }
  .product__media-wrapper--hero {
    scroll-snap-align: start;
    flex: 0 0 auto; /* ensures wrapper doesn’t shrink */
    position: relative;
    display: inline-block;
  }
  .product__hero:has(.custom-select__price:not(:empty)) .product__media-wrapper--hero .base-overlay {
    display: none;
  }
  .product__media--hero {
    width: 572px;
    max-height: 401px;
    height: auto;
    object-fit: contain;
  }
  @media (max-width: 989px) {
    .product__media--hero {
      max-height: 28vh;
      width: 100vw;
      width: 100dvw;
    }
  }
  .base-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 572px;
    height: auto;
    object-fit: contain;
    pointer-events: none;
  }
  @media (max-width: 989px) {
    .base-overlay {
      max-height: 28vh;
      width: 100vw;
      width: 100dvw;
    }
  }
  .overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 572px;
    height: auto;
    object-fit: contain;
    pointer-events: none;
  }
  @media (max-width: 989px) {
    .overlay {
      max-height: 28vh;
      width: 100vw;
      width: 100dvw;
    }
  }
  .product__gallery-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 20;

    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: none;

    background: #d2d2d7a3;
    color: #000;
    font-size: 20px;
    cursor: pointer;

    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }
  .product__gallery-arrow:hover {
    transform: translateY(-50%) scale(1.05);
  }
  .product__gallery-arrow--left {
    left: 12px;
  }
  .product__gallery-arrow--right {
    right: 12px;
  }
  .product__gallery-dots {
    position: sticky;
    top: 427px;
    display: flex;
    justify-content: center;
    gap: 16px;
    padding-top: 2.6rem;
  }
  @media (max-width: 989px) {
    .product__gallery-dots {
      top: 35vh;
      padding-top: 1.3rem;
    }
  }
  .product__gallery-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: none;
    background: #bbb;
    cursor: pointer;
    padding: 0;
  }
  .product__gallery-dot.active {
    background: #000;
  }
  .hidden {
    display: none;
  }
  @media (min-width: 990px) {
    /* baseline: at least clear your site header (set this to your real header height) */
    .product__hero {
      --header-offset: 80px; /* adjust */
      --bar-offset: 0px; /* default: stickybar not active */
    }

    /* your existing sticky elements, but with the variable added */
    .product__gallery {
      position: sticky;
      top: calc(20px + var(--header-offset) + var(--bar-offset));
    }

    .product__gallery-dots {
      position: sticky;
      top: calc(427px + var(--header-offset) + var(--bar-offset));
    }

    /* when stickybar shows: push gallery + dots down by stickybar height */
    .product__stickybar.is-active ~ .product__hero {
      --bar-offset: 10px; /* approx full stickybar height (tweak) */
    }

    /* when compact: smaller push-down */
    .product__stickybar.is-active.is-compact ~ .product__hero {
      --bar-offset: 10px; /* approx compact stickybar height (tweak) */
    }
  }
{% endstyle %}

<script src="{{ 'custom-product.js' | asset_url }}" defer></script>

{% assign product_form_id = 'product_form_' | append: product.id %}
{% assign images = product.images %}
{% unless product.has_only_default_variant %}
{% assign images = product.selected_or_first_available_variant.metafields.custom.images.value %}
{% endunless %}
{% assign wall_layers = product.selected_or_first_available_variant.metafields.custom.walls.value %}
{%- assign positions = wall_layers | map: 'position' | uniq -%}
{% assign material = product.selected_or_first_available_variant.metafields.custom.material.value %}
{% assign fabric = product.selected_or_first_available_variant.metafields.custom.fabric.value %}
{% unless product.selected_or_first_available_variant.available == false %}
  {% assign show_dynamic_checkout = true %}
  {% if wall_layers != blank %}
    {% if wall_layers.size > 0 %}
      {% assign show_dynamic_checkout = false %}
    {% endif %}
  {% endif %}
{% endunless %}
{% assign usps = product.metafields.custom.usps.value %}
<div class="product__hero--wrapper">
  <div class="quicknav__container" style="background-color: #fff;">
    <div class="quicknav">
      {% if product.metafields.custom.links %}
        <div class="product__tabnav" data-product-switcher>
          <ul class="product__tabnav--items">
            <span class="product__tabnav--label">{{ product.metafields.custom.label }}</span>
            {% for linked_product in product.metafields.custom.links.value %}
              <li class="product__tabnav--item{% if linked_product.id == product.id %} is-active{% endif %}">
                <button
                  type="button"
                  class="product__tabnav--btn"
                  data-product-url="{{ linked_product.url }}"
                  aria-pressed="{% if linked_product.id == product.id %}true{% else %}false{% endif %}"
                >
                  {{ linked_product.metafields.custom.size | escape }}
                </button>
              </li>
            {% endfor %}
          </ul>
        </div>

      {% else %}
        <div class="quicknav__category">
          {{ product.metafields.custom.label }}
        </div>
      {% endif %}

      <div>
        <div class="quicknav__quickbuy">
          <button
            type="submit"
            name="add"
            form="{{ product_form_id }}"
            style="
              max-height: 26px;
              font-size: 14px;
              padding: 1.3rem 2.6rem;
              min-height: 0;
            "
            class="product-form__submit button button--{%- if show_dynamic_checkout -%}transparent{% else %}primary{%- endif -%}"
            {% if product.selected_or_first_available_variant.available == false %}
              disabled
            {% endif %}
          >
            {%- if product.selected_or_first_available_variant.available -%}
              <div class="button__content">
                <span class="button__label" data-label="{{ 'products.product.add_to_cart' | t }}">
                  {{ 'products.product.add_to_cart' | t }}
                </span>
              </div>

              <div class="animated-button-circle"></div>

              <div class="loading-overlay__spinner hidden">
                {%- render 'icon-loading' -%}
              </div>
            {%- else -%}
              <span>
                {{ 'products.product.sold_out' | t }}
              </span>
            {%- endif -%}
          </button>
        </div>
      </div>
    </div>
    <div class="quicknav__border"></div>
  </div>

  <style>
    .product__tabnav--label {
      font-size: 21px;
      font-weight: 600;
      letter-spacing: 0.011em;
      line-height: 1.1428571429;
    }
    .product__tabnav {
      margin-top: 8px;
      margin-bottom: 8px;
      display: flex;
      justify-content: center;
    }
    .product__tabnav--items {
      display: flex;
      align-items: center;
      gap: 20px;
      font-size: 14px;
      line-height: 1.2857742857;
      font-weight: 400;
      letter-spacing: -0.016em;
    }
    .product__tabnav--item {
      min-width: 60px;
      width: auto;
      border-radius: 980px;
      margin: 4px 0;
      padding: 0;
      overflow: hidden;
      background-color: rgb(232 232 237/70%);
      border: 1px solid rgba(0, 0, 0, 0.16);
    }
    .product__tabnav--item:hover {
      background-color: rgb(232, 232, 237);
    }
    .product__tabnav--item.is-active {
      background-color: rgb(29, 29, 31);
      color: #fff;
    }
    .product__tabnav--btn {
      display: block;
      width: 100%;
      padding: 3px 15px;
      border: 0;
      background: transparent;
      color: inherit;
      font: inherit;
      cursor: pointer;
      text-align: center;
    }
  </style>

  <div class="product__stickybar" data-sticky-bar aria-hidden="true">
    <div class="product__stickybar--area" data-position="top">
      <div
        class="product__stickybar--title"
      >
        {{ product.title }}
      </div>

      <div class="product__stickybar--price">
        <span class="product__stickybar--price-current">
          {{ product.selected_or_first_available_variant.price | money }}
        </span>

        {% unless product.selected_or_first_available_variant.compare_at_price == 0 %}
          <span class="product__stickybar--price-compare">
            {{ product.selected_or_first_available_variant.compare_at_price | money }}
          </span>
        {% endunless %}
      </div>
    </div>
    <div class="quicknav__border"></div>
    <div class="product__stickybar--area" data-position="bottom">
      <div class="product__stickybar--subarea">
        {% if product.metafields.custom.sticky_bar_usp %}
          {% for usp in product.metafields.custom.sticky_bar_usp.value %}
            <div class="product__stickybar--usp">{{ usp }}</div>
          {% endfor %}
        {% endif %}
      </div>
      <div class="product__stickybar--subarea">
        <div class="product__stickybar--element">Kostenloser Versand</div>
        <button
          type="submit"
          name="add"
          form="{{ product_form_id }}"
          style="
            max-height: 26px;
            font-size: 14px;
            padding: 1.3rem 2.6rem;
            min-height: 0;
          "
          class="product-form__submit button button--{%- if show_dynamic_checkout -%}transparent{% else %}primary{%- endif -%}"
          {% if product.selected_or_first_available_variant.available == false %}
            disabled
          {% endif %}
        >
          {%- if product.selected_or_first_available_variant.available -%}
            <div class="button__content">
              <span class="button__label" data-label="{{ 'products.product.add_to_cart' | t }}">
                {{ 'products.product.add_to_cart' | t }}
              </span>
            </div>

            <div class="animated-button-circle"></div>

            <div class="loading-overlay__spinner hidden">
              {%- render 'icon-loading' -%}
            </div>
          {%- else -%}
            <span>
              {{ 'products.product.sold_out' | t }}
            </span>
          {%- endif -%}
        </button>
      </div>
    </div>
    <div class="quicknav__border" data-sticky-divider="mid"></div>
  </div>

  <div class="product__hero">
    <div class="product__sticky-scope">
      <div class="product__sticky">
        <div class="product__header {% if usps == blank or usps.size == 0 %} no-usps{% endif %}">
          <span class="sticky-sentinel" data-sticky-start aria-hidden="true"></span>
          <h1 class="product__title">{{ product.title }}</h1>
          {% if usps != blank and usps.size > 0 %}
            <p class="product__title--intro">
              {% for usp in usps %}
                <span class="product__usp{% unless forloop.last %} is-separated{% endunless %}">
                  {{ usp }}
