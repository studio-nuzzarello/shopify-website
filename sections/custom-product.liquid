              {%- endif -%}

              {%- for option in product.options_with_values -%}
                {%- assign option_name_lowercase = option.name | downcase -%}

                {%- if option_name_lowercase contains 'farbe' or option_name_lowercase contains 'color' -%}{%- continue -%}{%- endif -%}
                {%- if option_name_lowercase contains 'größe'
                  or option_name_lowercase contains 'groesse'
                  or option_name_lowercase contains 'size'
                  or option_name_lowercase contains 'kapazität'
                -%}{%- continue -%}{%- endif -%}
                {%- if option_name_lowercase contains 'stoff' -%}{%- continue -%}{%- endif -%}

                {%- unless is_first_additional_property -%},{%- endunless -%}
                {
                  "@type": "PropertyValue",
                  "name": {{ option.name | json }},
                  "value": {{ variant.options[forloop.index0] | json }}
                }
                {%- assign is_first_additional_property = false -%}
              {%- endfor -%}
            {%- endcapture -%}

            {%- assign additional_property_items = additional_property_items | strip -%}
            {%- if additional_property_items != blank -%}
            "additionalProperty": [
