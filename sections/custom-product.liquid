                        </div>
                      {% endif %}
                    </div>
                  </div>
                </div>
              {% endfor %}
            </div>
          </div>
        {% endif %}

        {% unless product.has_only_default_variant %}
          <div class="optionValueSelectors" data-section-id="{{ section.id }}">
            {% for option in product.options_with_values %}
              <div class="product__option">
                <fieldset>
                  <legend>
                    {% if option.name == 'Farbe' %}
                      <h2 class="product__option-name">
                        {{ option.name }} - {{ product.selected_or_first_available_variant.options[forloop.index0] }}
                      </h2>
                    {% else %}
                      <span class="product__option-name">{{ option.name }}</span>
                    {% endif %}
                  </legend>

                  <div class="product__option-options {% if option.name == 'Farbe' %}hero-row{% else %}hero-wrap{% endif %}">
                    {% for option_value in option.values %}
                      {%- capture input_id -%}
                {{ section.id }}-{{ option.position }}-{{ forloop.index0 -}}
              {%- endcapture -%}

                      <div class="product__option-value {% if option.name == 'Farbe' %}flex-basis-0{% endif %}">
                        <input
                          type="radio"
                          class="product__option-input"
                          id="{{ input_id }}"
                          name="{{ option.name }}-{{ option.position }}"
                          value="{{ option_value | escape }}"
                          {% if option_value.selected %}
                            checked
                          {% endif %}
                          {% comment %}
                            {% unless option_value.available %}
                              disabled aria-disabled="true"
                            {% endunless %}
                          {% endcomment %}
                          data-option-value-id="{{ option_value.id }}"
                        >

                        {% if option.name == 'Farbe' %}
                          <label
                            class="color-swatch"
                            for="{{ input_id }}"
                            title="{{ option_value }}"
                            aria-label="{{ option.name }}: {{ option_value }}"
                          >
                            <div
                              class="colornav__item-border"
                              style="border: 2px solid {% if option_value.selected %}#0072e3{% else %}#e6e6e6{% endif %};"
                            >
                              <div class="colornav__item-whitespace">
                                <div
                                  class="colornav__item-swatch"
                                  style="background: {{ option_value.swatch.color }};"
                                ></div>
                              </div>
                            </div>
                          </label>
                        {% else %}
                          {% assign words = option_value | split: ' ' %}
                          <label class="product__option-label" for="{{ input_id }}">
                            <span class="label-main">
                              {{- words[0] }}
                              {{ words[1] -}}
                            </span>
                            {% if words.size > 2 %}
                              <span class="label-small">{{ words | slice: 2, words.size | join: ' ' }}</span>
                            {% endif %}
                          </label>
                        {% endif %}
                      </div>
                    {% endfor %}
                  </div>
                </fieldset>
              </div>
            {% endfor %}
          </div>
        {% endunless %}
        <span class="sticky-sentinel" data-sticky-compact aria-hidden="true"></span>
      </div>
    </div>
    <div class="product__buyform">
      {% render 'shipping-info', product: product %}
      {% form 'product', product %}
        {% if product.selected_or_first_available_variant.metafields.custom.walls %}
          <input type="hidden" name="items[0][id]" value="{{ product.selected_or_first_available_variant.id }}">
          <input type="hidden" name="items[0][quantity]" class="form-qty" data-base="1" value="1">
        {% else %}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        {% endif %}
        <div class="product-form__buttons">
          <div class="product-form__buttons-row" style="flex-wrap: nowrap;">
            <div class="product-form__input product-form__quantity no-js-hidden">
              {%- assign cart_qty = cart | item_count_for_variant: product.selected_or_first_available_variant.id -%}
              <quantity-input class="quantity">
                <button class="quantity__button no-js-hidden focus-inset" name="minus" type="button">
                  <span class="visually-hidden">
                    {{- 'products.product.quantity.decrease' | t: product: product.title | escape -}}
                  </span>
                  {% render 'icon-minus' %}
                </button>
                <input
                  class="quantity__input focus-inset"
                  type="number"
                  name="quantity"
                  id="Quantity-{{ section.id }}"
                  data-cart-quantity="{{ cart_qty }}"
                  data-min="{{ product.selected_or_first_available_variant.quantity_rule.min }}"
                  min="{{ product.selected_or_first_available_variant.quantity_rule.min }}"
                  {% if product.selected_or_first_available_variant.inventory_quantity %}
                    data-max="{{ product.selected_or_first_available_variant.quantity_rule.max }}"
                    max="{{ product.selected_or_first_available_variant.quantity_rule.max }}"
                  {% endif %}
                  step="{{ product.selected_or_first_available_variant.quantity_rule.increment }}"
                  value="{{ product.selected_or_first_available_variant.quantity_rule.min }}"
                  form="{{ product_form_id }}"
                >
                <label class="visually-hidden" for="Quantity-{{ section.id }}">
                  {{ 'products.product.quantity.label' | t }}
                </label>
                <button class="quantity__button no-js-hidden focus-inset" name="plus" type="button">
                  <span class="visually-hidden">
                    {{- 'products.product.quantity.increase' | t: product: product.title | escape -}}
                  </span>
                  {% render 'icon-plus' %}
                </button>
              </quantity-input>
              <div class="quantity__rules caption">
                {%- if product.selected_or_first_available_variant.quantity_rule.increment > 1 -%}
                  <span class="divider">
                    {{-
                      'products.product.quantity.multiples_of'
                      | t: quantity: product.selected_or_first_available_variant.quantity_rule.increment
                    -}}
                  </span>
                {%- endif -%}
                {%- if product.selected_or_first_available_variant.quantity_rule.min > 1 -%}
                  <span class="divider">
                    {{-
                      'products.product.quantity.minimum_of'
                      | t: quantity: product.selected_or_first_available_variant.quantity_rule.min
                    -}}
                  </span>
                {%- endif -%}
                {%- if product.selected_or_first_available_variant.quantity_rule.max != null -%}
                  <span class="divider">
                    {{-
                      'products.product.quantity.maximum_of'
                      | t: quantity: product.selected_or_first_available_variant.quantity_rule.max
                    -}}
                  </span>
                {%- endif -%}
              </div>
            </div>

            <button
              type="submit"
              name="add"
              class="product-form__submit button button--{%- if show_dynamic_checkout -%}transparent{% else %}primary{%- endif -%}"
              {% if product.selected_or_first_available_variant.available == false %}
                disabled
              {% endif %}
            >
              {%- if product.selected_or_first_available_variant.available -%}
                <div class="button__content">
                  <span class="button__label" data-label="{{ 'products.product.add_to_cart' | t }}">
                    {{ 'products.product.add_to_cart' | t }}
                  </span>
                </div>

                <div class="animated-button-circle"></div>

                <div class="loading-overlay__spinner hidden">
                  {%- render 'icon-loading' -%}
                </div>
              {%- else -%}
                <span>
                  {{ 'products.product.sold_out' | t }}
                </span>
              {%- endif -%}
            </button>
          </div>
          {%- if show_dynamic_checkout -%}
            <div class="product-form__checkout no-js-hidden">
              {{ form | payment_button }}
            </div>
          {%- endif -%}
        </div>
      {% endform %}
    </div>
  </div>

  <span class="sticky-sentinel" data-sticky-end aria-hidden="true"></span>
  <div class="product-accordion--wrapper">
    <details class="product-accordion" open>
      <summary class="product-accordion__button" aria-controls="acc-prodinfo">
        <h2 id="acc-prodinfo-title" class="product-accordion__title">Produktinformationen</h2>
        <img
          class="product-accordion__chevron"
          src="https://cdn.shopify.com/s/files/1/0615/9302/6783/files/chevron-down-badge.svg?v=1747152730"
          width="28"
          height="28"
          alt="Chevron unten"
          aria-hidden="true"
          loading="lazy"
          decoding="async"
        >
      </summary>

      <div class="product-accordion__section" id="acc-prodinfo" role="region" aria-labelledby="acc-prodinfo-title">
        <h3 class="product-accordion__section-title">Überblick</h3>
        <div class="product-accordion__section-content">
          <div class="product-accordion__section-text">
            {{ product.description }}
          </div>
        </div>
      </div>
      <div class="product-accordion__section">
        <h3 class="product-accordion__section-title">Features</h3>
        <div class="product-accordion__section-content">
          <div class="product-accordion__section-text">{{ product.metafields.custom.features | metafield_tag }}</div>
        </div>
      </div>
      <div class="product-accordion__section">
        <h3 class="product-accordion__section-title">Lieferumfang</h3>
        <div class="product-accordion__section-content">
          <div class="product-accordion__section-text">
            {{ product.metafields.custom.included_items | metafield_tag }}
          </div>
        </div>
      </div>
      <div class="product-accordion__section">
        <h3 class="product-accordion__section-title">Herstellerinformationen</h3>
        <div class="product-accordion__section-content">
          <div class="product-accordion__section-text">
            {{ product.metafields.custom.gpsr | metafield_tag }}
          </div>
          {% if product.selected_or_first_available_variant.sku %}
            <div class="product-accordion__section-text">
              <strong>Produktidentifikation</strong> 
              <br>SKU: {{ product.selected_or_first_available_variant.sku }}
            </div>
        {% endif %}
        </div>
      </div>
    </details>
    {% if material or fabric %}
      <details class="product-accordion">
        <summary class="product-accordion__button" style="border:none;">
          <h2 class="product-accordion__title">Technische Daten</h2>
          <img
            class="product-accordion__chevron"
            src="https://cdn.shopify.com/s/files/1/0615/9302/6783/files/chevron-down-badge.svg?v=1747152730"
            width="28"
            height="28"
            alt="Chevron unten"
            aria-hidden="true"
            loading="lazy"
            decoding="async"
          >
        </summary>

        {% if material %}
          {%- comment -%} Material Section {%- endcomment -%}
          <div class="product-accordion__section">
            <h3 class="product-accordion__section-title">Material</h3>
            <div class="product-accordion__section-content">
              <h4 class="product-accordion__section-subtitle">Rahmen-Serie</h4>
              <div class="product-accordion__section-text">
                {{ material.label }}
              </div>
              <h4 class="product-accordion__section-subtitle">Basismaterial</h4>
              <div class="product-accordion__section-text">
                {{ material.base_material }}
              </div>
              <h4 class="product-accordion__section-subtitle">Form</h4>
              <div class="product-accordion__section-text">
                {{ material.form }}
              </div>
              <h4 class="product-accordion__section-subtitle">Verbindermaterial</h4>
              <div class="product-accordion__section-text">
                {{ material.joints_material }}
              </div>
              <h4 class="product-accordion__section-subtitle">Gelenkematerial</h4>
              <div class="product-accordion__section-text">
                {{ material.connectors_material }}
              </div>
              <h4 class="product-accordion__section-subtitle">Höhenverstellbarkeit</h4>
              <div class="product-accordion__section-text">
                {{ material.height_adjustment }}
              </div>
              <h4 class="product-accordion__section-subtitle">Klettverschluss</h4>
              <div class="product-accordion__section-text">
                {{ material.velcro }}
              </div>
              <h4 class="product-accordion__section-subtitle">Sicherungsbolzen</h4>
              <div class="product-accordion__section-text">
                {{ material.safety_pin }}
              </div>
              <h4 class="product-accordion__section-subtitle">Materialstärke</h4>
              <div class="product-accordion__section-text">
                {{ material.strength | metafield_text }}
              </div>
              <h4 class="product-accordion__section-subtitle">Diagonale</h4>
              <div class="product-accordion__section-text">
                {{ material.diagonal_length | metafield_text }}
              </div>
              <h4 class="product-accordion__section-subtitle">Minimale Durchgangshöhe</h4>
              <div class="product-accordion__section-text">
                {{ material.clearance_height_min | metafield_text }}
              </div>
              <h4 class="product-accordion__section-subtitle">Maximale Durchgangshöhe</h4>
              <div class="product-accordion__section-text">
                {{ material.clearance_height_max | metafield_text }}
              </div>

              {% assign scissor_frame = material.scissor_frame.value %}
              {% assign values = '' %}

              {% for dimension in scissor_frame %}
                {% assign values = values | append: dimension.value | append: ' ' | append: dimension.unit %}
                {% unless forloop.last %}
                  {% assign values = values | append: ' x ' %}
                {% endunless %}
              {% endfor %}

              <h4 class="product-accordion__section-subtitle">Scherengestänge</h4>
              <div class="product-accordion__section-text">
                {{ values }}
              </div>
              {% assign ridge_height = material.ridge_height.value %}
              {% assign values = '' %}

              {% for dimension in ridge_height %}
                {% assign values = values | append: dimension.value | append: ' ' | append: dimension.unit %}
                {% unless forloop.last %}
                  {% assign values = values | append: ' - ' %}
                {% endunless %}
              {% endfor %}

              <h4 class="product-accordion__section-subtitle">Höhe Dachfirst</h4>
              <div class="product-accordion__section-text">
                {{ values }}
              </div>

              {% assign values = '' %}
              {% for dimension in product.metafields.custom.packed_dimension.value %}
                {% assign values = values | append: dimension.value | append: ' ' | append: dimension.unit %}
                {% unless forloop.last %}
                  {% assign values = values | append: ' x ' %}
                {% endunless %}
              {% endfor %}

              <h4 class="product-accordion__section-subtitle">Packmaß</h4>
              <div class="product-accordion__section-text">
                {{ values }}
              </div>

              <h4 class="product-accordion__section-subtitle">Gewicht</h4>
              <div class="product-accordion__section-text">
                {{ product.metafields.custom.weight.value }}
                {{ product.metafields.custom.weight.unit }}
              </div>
            </div>
          </div>
        {% endif %}

        {% if fabric %}
          {%- comment -%} Fabric Section {%- endcomment -%}
          <div class="product-accordion__section">
            <h3 class="product-accordion__section-title">Stoff</h3>
            <div class="product-accordion__section-content">
              <h4 class="product-accordion__section-subtitle">Basismaterial</h4>
              <div class="product-accordion__section-text">
                {{ fabric.material }}
              </div>
              <h4 class="product-accordion__section-subtitle">Innenbeschichtung</h4>
              <div class="product-accordion__section-text">
                {{ fabric.internal_coating }}
              </div>
              <h4 class="product-accordion__section-subtitle">Farbe der Innenbeschichtung</h4>
              <div class="product-accordion__section-text">
                {{ fabric.internal_color }}
              </div>
              <h4 class="product-accordion__section-subtitle">UV-Schutzklasse</h4>
              <div class="product-accordion__section-text">
                {{ fabric.uv_protection_rating }}
              </div>
              <h4 class="product-accordion__section-subtitle">Beständigkeit gegen Ausbleichen</h4>
              <div class="product-accordion__section-text">
                {{ fabric.fade_resistance }}
              </div>
              <h4 class="product-accordion__section-subtitle">Lichtechtheitsstufe</h4>
              <div class="product-accordion__section-text">
                {{ fabric.lightfastness_rating }}
              </div>
              <h4 class="product-accordion__section-subtitle">B1 Zertifiziert</h4>
              <div class="product-accordion__section-text">
