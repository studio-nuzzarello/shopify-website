              {%- endif -%}
            {%- endif -%}

            {%- if product.metafields.custom.weight.value -%}
              "weight": {
                "@type": "QuantitativeValue",
                "value": {{ product.metafields.custom.weight.value.value | json }},
                "unitText": {{ product.metafields.custom.weight.value.unit | json }}
              },
            {% endif %}

            {%- assign variant_color = nil -%}
            {%- assign variant_size = nil -%}
            {%- assign variant_material = nil -%}
            {%- for option in product.options_with_values -%}
              {%- assign name = option.name | downcase -%}
              {%- assign val = variant.options[forloop.index0] -%}
              {%- if name contains 'farbe' or name contains 'color' -%}
                {%- assign variant_color = val -%}
              {%- elsif name contains 'size' or name contains 'kapazität' -%}
                {%- assign variant_size = val -%}
              {%- elsif name contains 'stoff' -%}
                {%- assign variant_material = val -%}
              {%- endif -%}
            {%- endfor -%}

            {%- if variant_color -%}
            "color": {{ variant_color | json }},
            {%- endif -%}
            {%- if variant_size -%}
            "size": {{ variant_size | json }},
            {%- endif -%}
            {%- if variant_material -%}
            "material": {{ variant_material | json }},
            {%- endif -%}

            {%- capture additional_property_items -%}
              {%- assign is_first_additional_property = true -%}

              {%- if variant.metafields.custom.fabric.value.b1_zertifiziert -%}
                {%- if variant.metafields.custom.fabric.value.b1_zertifiziert.value == true -%}
                  {%- assign b1_text = 'Ja' -%}
                {%- endif -%}

                {%- unless is_first_additional_property -%},{%- endunless -%}
                {
                  "@type": "PropertyValue",
                  "name": "B1 Zertifiziert",
                  "value": {{ b1_text | json }}
