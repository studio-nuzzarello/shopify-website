                  <select
                    class="product__configuration-select js-native-select"
                    name="walls"
                    aria-label="Seitenwand auswählen: {{ position }}"
                  >
                    {% assign layers_for_position = wall_layers | where: 'position', position %}

                    {% assign standard_layers = layers_for_position | where: 'group', 'Standard' %}
                    {% assign printed_layers = layers_for_position | where: 'group', 'Bedruckt' %}

                    {% if standard_layers.size > 0 %}
                      <optgroup label="Standard">
