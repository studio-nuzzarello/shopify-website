{% style %}
  @media (min-width: 990px) {
    .product__stickybar.is-compact [data-sticky-divider='mid'] {
      display: none;
    }
  }
  .product__stickybar {
    display: none;
  }
  @media (min-width: 990px) {
    .product__stickybar {
      display: block;
      position: fixed;
      left: 0;
      right: 0;
      top: var(--stickybar-top, 0px);
      z-index: 80;
      background: #fff;

      transform: translateY(-120%);
      opacity: 0;
      pointer-events: none;
      transition: transform 0.25s cubic-bezier(0, 0, 0.5, 1), opacity 0.2s ease;
    }

    .product__stickybar.is-active {
      transform: translateY(0);
      opacity: 1;
      pointer-events: auto;
    }

    /* bottom area collapses earlier */
    .product__stickybar--area[data-position='bottom'] {
      max-height: 120px; /* enough to fit content */
      opacity: 1;
      overflow: hidden;
      transition: max-height 0.25s cubic-bezier(0, 0, 0.5, 1), opacity 0.2s ease;
    }

    .product__stickybar.is-compact .product__stickybar--area[data-position='bottom'] {
      max-height: 0;
      opacity: 0;
      pointer-events: none;
    }
  }

  .sticky-sentinel {
    display: block;
    height: 1px;
  }
  .product__stickybar--area {
    display: flex;
    justify-content: space-between;
    max-width: 1140px;
