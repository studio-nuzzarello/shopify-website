  .product__hero--wrapper {
    background-color: #fff;
  }
  /* DESKTOP */
  .product__hero {
    max-width: 1140px;
    margin: 50px auto;

    display: grid;
    grid-template-columns: 33.3333% 58.3333%;
    column-gap: 8.3333%;
    grid-template-areas:
      'header  gallery'
      'config  gallery'
      'buyform gallery';
    align-items: start;
  }

  /* Scope wrapper soll auf Desktop nichts verändern */
  .product__sticky-scope {
    display: contents;
  }

  /* Wrapper soll auf Desktop NICHT layouten (nur für Mobile sticky) */
  .product__sticky {
    display: contents;
  }

  /* Header links oben (liegt in .product__sticky -> display:contents macht ihn zum Grid-Item) */
  .product__header {
    grid-area: header;
    padding-left: 8rem;
    margin-bottom: 12px;
  }

  /* Konfig links */
  .product__section-a {
    grid-area: config;
    padding-left: 8rem;
    max-width: 100%;
    overflow-x: hidden;
  }

  /* Buyform links unter config */
  .product__buyform {
    grid-area: buyform;
    max-width: 100%;
  }
  @media (min-width: 989px) {
    .product__buyform {
      margin-left: 8rem;
    }
  }

  /* Galerie rechts über alle Zeilen */
  .product__section-b {
    grid-area: gallery;
    padding-right: 8rem;
    max-width: 100%;
    margin-left: 0;

    display: flex;
    flex-direction: column;
    align-self: stretch;
    min-height: 0;
  }

  /* Galerie-Kinder sollen Höhe sauber füllen */
  .product__gallery-container {
    flex: 1;
    position: relative;
    height: 100%;
    min-height: 0;
  }
  .product__gallery {
    min-height: 0;
  }

  /* MOBILE */
  @media (max-width: 989px) {
    /* Mobile: wir wollen Sticky nur bis zum Ende vom Scope */
    .product__hero {
      display: block;
      max-width: none;
      margin: 0;
      padding-bottom: 5.2rem;
    }

    .product__sticky-scope {
      display: block; /* <-- macht es zur Sticky-Grenze */
    }

    .product__sticky {
      display: flex;
      flex-direction: column;

      position: sticky;
      top: 0;
      z-index: 20;
      background: #fff;
    }

