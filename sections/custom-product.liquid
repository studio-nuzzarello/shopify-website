      padding-top: 18px;
      margin-bottom: 12px;
      padding-bottom: 18px;
      border-bottom: 1px solid #d2d2d7;
    }

    .product__section-b {
      position: static; /* sticky macht der Wrapper */
      height: 33vh;
      padding: 0;
    }

    .product__gallery-container {
      height: 100%;
    }

    .product__section-a,
    .product__buyform {
      padding-left: 2rem;
      padding-right: 2rem;
