  }
  @supports (animation-timeline: scroll()) {
    .product__title--intro {
      transform-origin: top;
      animation: introHide linear both;
      animation-timeline: scroll(root);
      animation-range: 0px 80px; /* fade out over first 80px of scroll */
    }

    @keyframes introHide {
      from {
        opacity: 1;
        max-height: 60px;
        transform: translateY(0);
      }
      to {
        opacity: 0;
        max-height: 0;
        transform: translateY(-4px);
