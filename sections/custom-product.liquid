        </div>
        <div class="product__section-b">
          <div class="product__gallery-container">
            <div class="product__gallery" role="region" aria-roledescription="carousel" aria-label="Produktbilder">
              <div class="product__gallery-scroll" tabindex="0">
                {% unless product.has_only_default_variant %}
                  <div
                    class="product__media-wrapper--hero"
                    role="group"
                    aria-roledescription="slide"
                    aria-label="Slide 1"
                  >
                    {% assign alt = product.selected_or_first_available_variant.featured_image.alt
                      | default: product.title
                      | append: ' – '
                      | append: product.selected_or_first_available_variant.title
                      | append: ' – '
                      | append: '1'
                    %}
                    {{
                      product.selected_or_first_available_variant.featured_image
                      | image_url: width: 1144
                      | image_tag:
                        class: 'product__media--hero',
                        width: 1144,
                        preload: true,
                        fetchpriority: 'high',
                        loading: 'eager',
                        alt: alt
                    }}

                    {% for overlay in product.metafields.custom.overlay.value %}
                      {% assign alt = overlay.alt | default: 'Seitenwand Overlay' %}
                      {{
                        overlay
                        | image_url: width: 1144
                        | image_tag:
                          class: 'base-overlay',
                          width: 1144,
                          fetchpriority: 'high',
                          loading: 'eager',
                          alt: alt,
                          aria-hidden: 'true'
                      }}
                    {% endfor %}
                    {% for layer in wall_layers %}
                      {% assign alt = layer.alt_text | default: 'Seitenwand Overlay' %}
                      {% capture wall_reference %}{{ layer.position | handle }}-{{ layer.variant.value.id }}{% endcapture %}
                      {% capture z_style %}z-index: {{ layer.z_index }};{% endcapture %}
                      {{
                        layer.image
                        | image_url: width: 1144
                        | image_tag:
                          class: 'overlay hidden',
                          style: z_style,
                          width: 1144,
                          loading: 'lazy',
                          fetchpriority: 'low',
                          alt: alt,
                          aria-hidden: 'true',
                          data-wall-reference: wall_reference
                      }}
                    {% endfor %}
                  </div>
                {% endunless %}
                {% for image in images %}
                  {% assign alt = image.alt
