              "seller": { "@type": "Organization", "name": {{ shop.name | json }}, "url": {{ shop.url | json }} },
              "shippingDetails": { "@id": {{ ship_id | json }} },
              "hasMerchantReturnPolicy": { "@id": {{ return_id | json }} }
