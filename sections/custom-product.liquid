{%- assign canonical_url = shop.url | append: product.url -%}
{%- assign ship_id = canonical_url | append: '#shipping_policy' -%}
{%- assign return_id = canonical_url | append: '#return_policy' -%}
{%- assign group_id = canonical_url | append: '#productgroup' -%}
{%- assign product_id = canonical_url | append: '#product' -%}

{%- assign variant_count = product.variants | size -%}
{%- assign use_group = false -%}
{%- if variant_count > 1 -%}
  {%- assign use_group = true -%}
{%- endif -%}

{%- capture varies_by_raw -%}{%- endcapture -%}

{%- for option in product.options_with_values -%}
  {%- assign option_name = option.name | downcase -%}

  {%- if option_name == 'title' or option_name == 'titel' -%}
    {%- continue -%}
  {%- endif -%}

  {%- assign prop = option.name -%}
  {%- if option_name contains 'farbe' or option_name contains 'color' -%}
    {%- assign prop = 'https://schema.org/color' -%}
  {%- elsif option_name contains 'size' or option_name contains 'kapazität' -%}
    {%- assign prop = 'https://schema.org/size' -%}
  {%- elsif option_name contains 'stoff' -%}
    {%- assign prop = 'https://schema.org/material' -%}
  {%- elsif option_name contains 'muster' or option_name contains 'pattern' -%}
    {%- assign prop = 'https://schema.org/pattern' -%}
  {%- else -%}
    {%- assign prop = 'https://schema.org/additionalProperty' -%}
  {%- endif -%}

  {%- capture varies_by_raw -%}{{ varies_by_raw }}||{{ prop }}{%- endcapture -%}
{%- endfor -%}

{%- assign varies_by_arr = varies_by_raw | remove_first: '||' | split: '||' | uniq -%}

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [

      {%- if use_group -%}
      {
        "@type": "ProductGroup",
        "@id": {{ group_id | json }},
        "name": {{ product.title | json }},
        "description": {{ product.description | strip_html | strip_newlines | json }},
        "url": {{ canonical_url | json }},
