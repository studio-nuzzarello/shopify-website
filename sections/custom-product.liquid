                  {%- if material.clearance_height_min.value -%}
                    { "@type": "QuantitativeValue", "name": "Minimale Durchgangshöhe", "value": {{ material.clearance_height_min.value.value | json }}, "unitText": {{ material.clearance_height_min.value.unit | json }} }
                  {% endif %}
