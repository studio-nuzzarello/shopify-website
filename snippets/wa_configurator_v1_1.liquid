        class="customization__summary-image hidden"
        data-summary-handle="{{ print.metafields.custom.customization_pair | handleize }}-{{ print.metafields.custom.print_type | handleize }}"
      >
        {% if print.featured_image %}
          {{
            print.featured_image
            | image_url: height: 160
            | image_tag: style: 'max-width: 80%; max-height: 80%; object-fit: contain;'
          }}
