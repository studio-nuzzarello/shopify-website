      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="#007900"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="icon icon-tabler icons-tabler-outline icon-tabler-check"
    >
      <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
      <path d="M5 12l5 5l10 -10" />
    </svg>
  </div>

  <style>
    .customization__summary {
      display: block;
      background-color: #fafafc;
      border-radius: 18px;
      padding: 30px;
      margin-top: 2.6rem;
    }
    .customization__summary.hidden {
      display: none;
    }
    .customization__summary-productname {
      font-size: 22px;
      font-weight: 600;
      letter-spacing: 0;
      line-height: 1.1;
      padding-bottom: 1.3rem;
    }
    .customization__summary-printname {
      display: block;
      margin-bottom: 11px;
      font-size: 14px;
      font-weight: 400;
      letter-spacing: -0.016em;
      line-height: 1.4285914286;
    }
    .customization__summary-printname.hidden {
      display: none;
    }
    .customization__summary-images {
      display: flex;
      flex-wrap: wrap;
      margin-top: 1.3rem;
      margin-left: 30px;
    }
    .customization__summary-images.hidden {
      display: none;
    }
