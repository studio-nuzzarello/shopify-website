    }
  </style>

  <div class="customization__summary hidden">
    <div class="customization__summary-productname">{{ product.title }} - konfiguriert</div>
    {% for print in product.metafields.custom.available_prints.value %}
      <div
        class="customization__summary-printname hidden"
        data-summary-handle="{{ print.metafields.custom.customization_pair | handleize }}-{{ print.metafields.custom.print_type | handleize }}"
      >
        {{ print.title }}
        {% if print.metafields.custom.color_space %}
          <span
            >-
            {% if print.metafields.custom.color_space == 'CMYK' %}
              <img
                src="https://cdn.shopify.com/s/files/1/0615/9302/6783/files/cmyk.svg?v=1748002971"
                width="17"
                height="17"
                style="
                  display: inline; height: 17px;
                  vertical-align: text-bottom;
                "
              >
            {% endif %}
            {% if print.metafields.custom.color_space == 'PMS' %}
              <img
                src="https://cdn.shopify.com/s/files/1/0615/9302/6783/files/pantone.png?v=1748002866"
                width="14"
                height="14"
                style="
                  display: inline; height: 14px;
                  vertical-align: text-bottom;
                "
