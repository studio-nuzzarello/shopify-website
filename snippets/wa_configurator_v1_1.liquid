{% if product.metafields.custom.configurator_products %}
  <div id="colornav" class="colornav">
    <h2 class="section-label colornav__label">
      Farben. <span class="label-subtext">Wählen Sie Ihre bevorzugte Farbe.</span>
    </h2>
    <ul class="colornav__items">
      {% for variant in product.metafields.custom.configurator_products.value %}
        <li class="colornav__item">
          <a class="colornav__item-link" href="{{ variant.url }}#colornav">
            <div
              class="colornav__item-border"
              style=" border: 2px solid {% if variant.id == product.id %}#FF4014{% else %}#e6e6e6{% endif %};"
            >
              <div class="colornav__item-whitespace">
                <div
                  class="colornav__item-swatch"
                  style="background: {{ variant.metafields.custom.color_hex }};"
                ></div>
              </div>
            </div>
            <div class="colornav__item-names">
              {{ variant.metafields.custom.color }}
              <br>
              {{ variant.metafields.custom.color_pms }}
            </div>
          </a>
        </li>
      {% endfor %}
    </ul>
  </div>
{% endif %}

{{ 'wa_configurator_v1_1.js' | asset_url | script_tag }}

{% assign fix_costs = all_products['fixe-druckkosten'] %}

{%- assign fix_cost_config = '{' -%}
{%- for variant in fix_costs.variants -%}
  {%- assign qty_key = variant.title | split: '-' | last | remove: 'Preisklasse' | remove: 'preisklasse' | strip -%}
  {%- if forloop.index0 != 0 -%}
    {%- assign fix_cost_config = fix_cost_config | append: ',' -%}
  {%- endif -%}
  {%- assign fix_cost_config = fix_cost_config
    | append: '"'
    | append: qty_key
    | append: '":{"id":'
    | append: variant.id
    | append: ',"price":'
    | append: variant.price
    | append: '}'
  -%}
{%- endfor -%}
{%- assign fix_cost_config = fix_cost_config | append: '}' -%}

<script type="application/json" id="configurator-product-setup">
  {{ fix_cost_config }}
</script>

{%- assign product_config = '{' -%}
{% if product.has_only_default_variant %}
  {%- assign qty_key = 1 -%}
  {%- assign product_config = product_config
    | append: '"'
    | append: qty_key
    | append: '":{"id":'
    | append: product.first_available_variant.id
    | append: ',"price":'
    | append: product.price
    | append: '}'
  -%}
{% else %}
  {%- for variant in product.variants -%}
    {%- assign qty_key = variant.title | split: '-' | last | remove: 'Staffelpreis' | remove: 'staffelpreis' | strip -%}
    {%- if forloop.index0 != 0 -%}
      {%- assign product_config = product_config | append: ',' -%}
    {%- endif -%}
    {%- assign product_config = product_config
      | append: '"'
      | append: qty_key
      | append: '":{"id":'
      | append: variant.id
      | append: ',"price":'
      | append: variant.price
      | append: '}'
    -%}
  {%- endfor -%}
{% endif %}
{%- assign product_config = product_config | append: '}' -%}

<script type="application/json" id="configurator-product-data">
  {{ product_config }}
</script>

