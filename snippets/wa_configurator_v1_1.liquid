<div class="customization">
  <h2 class="section-label customization__label">
    Konfiguration. <span class="label-subtext">Gestalten Sie Ihren Artikel nach Ihren Wünschen.</span>
  </h2>

  <div class="customization__section" data-section="print-area">
    <div class="customization__progressbar">
      <div class="customization__progressbar-elements">
        <div class="customization__progressbar-circle" data-section="print-area"></div>
        <div class="customization__progressbar-rectangle" data-section="print-area"></div>
      </div>
    </div>
    <div class="customization__interaction">
      <div class="customization__interaction-label">Druckfläche(n)</div>
      <div class="customization__interaction-buttons">
        {% assign unformatted_print_areas = product.metafields.custom.available_print_areas %}
        {% assign formatted_print_areas = unformatted_print_areas | remove: '[' | remove: ']' | remove: '"' %}
        {% assign available_print_areas = formatted_print_areas | split: ',' %}
        {% for print_area in available_print_areas %}
          <input
            type="checkbox"
            id="{{ print_area | handleize }}"
            class="customization__button"
            name="print-area-choices"
            data-section="print-area"
            value="{{ print_area | handleize }}"
          >
          <label for="{{ print_area | handleize }}" class="customization__button-label">
            {{ print_area }}
          </label>
        {% endfor %}
      </div>
    </div>
  </div>

  <style>
    .block-wrapper {
      display: block;
    }
    .customization__option {
      display: flex; /* default hidden */
      flex-direction: column;
      align-items: flex-start;
      margin-bottom: 1.3rem;
    }
    .customization__option.hidden {
      display: none;
    }
    .customization__option-label {
      font-size: 14px;
      letter-spacing: -0.05em;
      line-height: 1.1;
      font-weight: bold;
      padding-bottom: 1.3rem;
      margin-bottom: 1.3rem;
      border-bottom: 1px solid #d2d2d7;
    }
    .customization__choices {
      display: flex;
      justify-content: flex-start;
      flex-wrap: wrap;
      gap: 6px 3px;
      margin-bottom: 0.6rem;
    }
    .customization__choice {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
    }
    .variants-wrapper {
      display: block;
      margin-bottom: 1.3rem;
    }
    .variants-wrapper.hidden {
      display: none;
    }
    .customization__variants-label {
      max-width: 69px;
      font-size: 14px;
      letter-spacing: -0.05em;
      line-height: 1.1;
      font-weight: 600;
      margin-bottom: 1.3rem;
      margin-top: 1.3rem;
      background: #016ce0;
      color: #ffffff;
      border-radius: 0.5rem;
      padding: 0.125rem 0.5rem;
    }
    .customization__variants {
      display: flex;
      justify-content: flex-start;
      flex-wrap: wrap;
      gap: 6px 3px;
      margin-bottom: 1.3rem;
    }
    .customization__button[data-section='variant']:checked + .customization__button-label {
      background-color: #dbdcf2;
      color: #2925af;
      border-color: rgb(207, 208, 229);
    }
  </style>

  <div class="customization__section hidden" data-section="print-method">
    <div class="customization__progressbar">
      <div class="customization__progressbar-elements">
        <div class="customization__progressbar-circle" data-section="print-method"></div>
        <div class="customization__progressbar-rectangle" data-section="print-method"></div>
      </div>
    </div>
    <div class="customization__interaction">
      <div class="customization__interaction-label">Druckverfahren</div>
      <div class="customization__interaction-buttons">
        <div class="block-wrapper">
          {% for print_area in available_print_areas %}
            <div class="customization__option hidden">
              <div class="customization__option-label" data-handle="{{ print_area | handleize }}">
                {{ print_area -}}
              </div>
              <div class="customization__choices">
                {% for print in product.metafields.custom.available_prints.value %}
                  {% if print.metafields.custom.customization_pair == print_area %}
                    <div class="customization__choice">
                      <input
                        type="radio"
                        id="{{ print_area | handleize }}-{{ print.metafields.custom.print_type | handleize }}"
                        class="customization__button"
                        data-section="print-method"
                        name="{{ print_area | handleize }}"
                        value="{{ print_area | handleize }}-{{ print.metafields.custom.print_type | handleize }}"
                      >
                      <label
                        for="{{ print_area | handleize }}-{{ print.metafields.custom.print_type | handleize }}"
                        class="customization__button-label"
                      >
                        {{ print.metafields.custom.print_type }}
                      </label>
                    </div>
                  {% endif %}
                {% endfor %}
              </div>
              {% for print in product.metafields.custom.available_prints.value %}
                {% if print.metafields.custom.customization_pair == print_area %}
                  {% if print.has_only_default_variant == false %}
                    {% assign input_name = print_area
                      | handleize
                      | append: '-'
                      | append: print.metafields.custom.print_type
                      | handleize
                    %}
                    <div class="variants-wrapper hidden" data-pair="{{ input_name }}">
                      <div class="customization__variants-label">Varianten</div>
                      <div class="customization__variants">
                        {% for option in print.options_by_name[print.options[0]].values %}
                          {%- assign setup_config = '' -%}
                          {% assign color_index = forloop.index %}
                          {%- for variant in print.variants -%}
                            {%- if variant.options[0] == option -%}
                              {%- assign qty_key = variant.title
                                | split: '-'
                                | last
                                | remove: 'Staffelpreis'
                                | remove: 'staffelpreis'
                                | strip
                              -%}

                              {%- unless setup_config == '' -%}
                                {%- assign setup_config = setup_config | append: ',' -%}
                              {%- endunless -%}

                              {%- assign setup_config = setup_config | append: '"' | append: qty_key | append: '":{' -%}
                              {%- assign setup_config = setup_config
                                | append: '"id":'
                                | append: variant.id
                                | append: ','
                              -%}
                              {%- assign setup_config = setup_config
                                | append: '"price":'
                                | append: variant.price
                                | append: ','
                              -%}

                              {%- assign setup_cost_base = print.metafields.custom.setup_cost.value | default: 2900 -%}
                              {%- assign setup_cost_type = print.metafields.custom.setup_cost_per_color.value -%}

                              {%- assign setup_cost = setup_cost_base -%}
                              {% if setup_cost_type == 'Per Color' %}
                                {%- assign setup_cost = setup_cost_base | times: color_index -%}
                              {% endif %}
                              {% if variant.metafields.custom.setup_cost.value %}
                                {%- assign setup_cost = variant.metafields.custom.setup_cost.value -%}
                              {% endif %}
                              {%- assign setup_config = setup_config | append: '"setup":' | append: setup_cost -%}
                              {%- assign setup_config = setup_config | append: '}' -%}
                            {%- endif -%}
                          {%- endfor -%}

                          <script
                            type="application/json"
                            id="script-{{ print_area | handleize }}-{{ print.metafields.custom.print_type | handleize }}-{{ option | handleize }}"
                          >
                            { {{ setup_config }} }
                          </script>

                          <input
                            type="radio"
                            id="{{ print_area | handleize }}-{{ print.metafields.custom.print_type | handleize }}-{{ option | handleize }}"
                            class="customization__button"
                            data-section="variant"
                            name="{{ input_name }}"
                            value="{{ print_area | handleize }}-{{ print.metafields.custom.print_type | handleize }}-{{ option | handleize }}"
                            data-script="script-{{ print_area | handleize }}-{{ print.metafields.custom.print_type | handleize }}-{{ option | handleize }}"
                          >
                          <label
                            for="{{ print_area | handleize }}-{{ print.metafields.custom.print_type | handleize }}-{{ option | handleize }}"
                            class="customization__button-label"
                          >
                            {{ option }}
                          </label>
                        {% endfor %}
                      </div>
                    </div>
                  {% endif %}
                {% endif %}
              {% endfor %}
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>

  <style>
    .customization__completed {
      display: flex;
      align-items: center;
    }
    .customization__completed.hidden {
      display: none;
    }
  </style>

  <div class="customization__completed hidden" data-section="print">
    <div class="customization__progressbar-circle active"></div>
    <div class="customization__interaction-label" style="margin-left: 6px;">
      Der Artikel wurde erfolgreich konfiguriert
    </div>
    <svg
      style="margin-left:3px; top:2px;"
      xmlns="http://www.w3.org/2000/svg"
